{
  "mutations": [
    {
      "name": "reset-to-1",
      "file": "rtl/counter.v",
      "old": "count <= 8'd0",
      "new": "count <= 8'd1"
    },
    {
      "name": "enable-wins-over-reset",
      "file": "rtl/counter.v",
      "old": "if (rst) count <= 8'd0;\n        else if (en) count <= count + 8'd1;",
      "new": "if (en) count <= count + 8'd1;\n        else if (rst) count <= 8'd0;"
    },
    {
      "name": "enable-ignored",
      "file": "rtl/counter.v",
      "old": "else if (en) count",
      "new": "else count"
    },
    {
      "name": "counts-by-2",
      "file": "rtl/counter.v",
      "old": "count + 8'd1",
      "new": "count + 8'd2"
    },
    {
      "name": "no-wrap",
      "file": "rtl/counter.v",
      "old": "count + 8'd1;",
      "new": "count + {7'd0, count != 8'hFF};"
    }
  ]
}

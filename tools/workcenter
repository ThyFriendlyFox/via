SI_PREFIX = {"p": 1e-12, "n": 1e-9, "u": 1e-6, "µ": 1e-6, "μ": 1e-6, "m": 1e-3, "k": 1e3, "M": 1e6, "G": 1e9}
SI_UNITS = {"V", "A", "W", "Ω", "Ohm", "F", "H", "s", "Hz", "J", "C"}

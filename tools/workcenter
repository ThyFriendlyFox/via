def quantity(text: str) -> tuple[float, float] | None:
    """A number with an optional SI prefix and unit, in SI, and half a unit of its last quoted digit.

    "4.7 mV" is (0.0047, 0.00005). A unit outside SI_UNITS ("°C", "%", "V/A") leaves the number as it is."""
    m = QUANTITY_RE.match(text.strip().replace("−", "-"))
    if not m:
        return None
    num, unit = m.group(1), m.group(2)
    scale = 1.0
    if unit not in SI_UNITS and len(unit) > 1 and unit[0] in SI_PREFIX and unit[1:] in SI_UNITS:
        scale = SI_PREFIX[unit[0]]
    mantissa, _, exponent = num.lower().partition("e")
    decimals = len(mantissa.partition(".")[2])
    half = 0.5 * 10.0 ** (int(exponent or 0) - decimals) * scale
    return float(num) * scale, half


def md_cells(line: str) -> list[str]:
    cells = re.split(r"(?<!\\)\|", line.strip().strip("|"))
    return [c.strip().replace("\\|", "|") for c in cells]


def md_tables(text: str) -> list[list[list[str]]]:
    """Every Markdown table in the text, as rows of cells, its separator row dropped."""
    tables: list[list[list[str]]] = []
    current: list[list[str]] | None = None
    for line in text.splitlines():
        s = line.strip()
        if not (s.startswith("|") and s.endswith("|") and len(s) > 1):
            current = None
            continue
        cells = md_cells(s)
        if current is None:
            current = []
            tables.append(current)
        if all(re.fullmatch(r":?-{3,}:?", c) for c in cells if c):
            continue
        current.append(cells)
    return tables


def code_span(cell: str) -> str | None:
    m = re.fullmatch(r"`([^`]+)`", cell.strip())
    return m.group(1).strip() if m else None


def plain_id(cell: str) -> str:
    return cell.strip().strip("`*").strip()


def headings(text: str, level: str = "## ") -> list[str]:
    return [ln[len(level) :].strip().lower() for ln in text.splitlines() if ln.startswith(level)]


def broken_links(md: Path) -> list[str]:
    out = []
    for target in LINK_RE.findall(md.read_text(encoding="utf-8")):
        if re.match(r"^[a-z][a-z0-9+.-]*:", target) or target.startswith("#"):
            continue
        path = target.split("#", 1)[0].replace("%20", " ")
        if path and not (md.parent / path).exists():
            out.append(f"{md.name}: link to {target} leads nowhere")
    return out


def parse_check(text: str) -> tuple[str, list[tuple[object, str, object]]] | None:
    """`deck.meas <= 30 V` or `3.0 V <= deck.meas <= 3.6 V`: the measure and its comparisons."""
    parts = COMPARE_RE.split(text.strip())
    if len(parts) not in (3, 5):
        return None
    operands: list[object] = []
    name = None
    for token in parts[0::2]:
        if MEAS_NAME_RE.match(token):
            if name is not None:
                return None
            name = token
            operands.append(None)
            continue
        q = quantity(token)
        if q is None:
            return None
        operands.append(q[0])
    if name is None:
        return None
    ops = [{"≤": "<=", "≥": ">="}.get(o, o) for o in parts[1::2]]
    return name, [(operands[i], ops[i], operands[i + 1]) for i in range(len(ops))]


def check_holds(comparisons: list[tuple[object, str, object]], value: float) -> bool:
    for left, op, right in comparisons:
        a = value if left is None else left
        b = value if right is None else right
        if not {"<=": a <= b, ">=": a >= b, "<": a < b, ">": a > b}[op]:
            return False
    return True


def quoted_matches(cell: str, value: float) -> bool | None:
    """None when the cell quotes no number; else whether the number is the run's, to its last digit."""
    q = quantity(cell)
    if q is None:
        return None
    quoted, half = q
    return abs(quoted - value) <= half * 1.0001 + 1e-15


def init_package(project: Project, package: Path) -> list[str]:
    """Copy the templates into the package, never over a file that exists; a writeup per deck."""
    created = []
    for src in sorted(p for p in VERIFY_TEMPLATES.rglob("*") if p.is_file()):
        rel = src.relative_to(VERIFY_TEMPLATES)
        if rel == DECK_TEMPLATE:
            continue
        dest = package / rel
        if not dest.exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, dest)
            created.append(str(dest))
    template = (VERIFY_TEMPLATES / DECK_TEMPLATE).read_text(encoding="utf-8")
    named = " ".join(p.read_text(encoding="utf-8") for p in package.glob("simulations/*/README.md"))
    sim_dir = project.dir / "sim"
    for deck in sorted(sim_dir.glob("*.cir")) if sim_dir.is_dir() else []:
        dest = package / "simulations" / deck.stem / "README.md"
        if f"sim/{deck.name}" in named or dest.exists():
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(template.replace("{deck}", deck.stem), encoding="utf-8")
        created.append(str(dest))
    return created


@timed
def gate_verify(
    project: Project, out: Path, package: Path | None = None, init: bool = False, strict: bool = False
) -> Result:
    package = package or project.dir / VERIFY_DIR
    created = init_package(project, package) if init else []
    if not package.is_dir():
        return Result("verify", "skip", f"no {package.name}/ package; `workcenter verify --init` writes one")
    if not shutil.which(NGSPICE):
        return Result("verify", "skip", f"engine missing: {NGSPICE}")
    problems: list[str] = []
    mds = sorted(package.rglob("*.md"))
    for rel in VERIFY_FILES:
        if not (package / rel).is_file():
            problems.append(f"missing {rel}")
    for md in mds:
        text = md.read_text(encoding="utf-8")
        if UNFILLED in text:
            problems.append(f"{md.relative_to(package)}: a section still says {UNFILLED} ... -->")
        problems += [f"{md.parent.relative_to(package)}/{p}" for p in broken_links(md)]

    # The requirements: one table or more under the header ID | Requirement | Limit | Source | Method |
    # Inspection, every cell filled and every method one of VERIFY_METHODS.
    requirements: dict[str, list[str]] = {}
    req_md = package / "requirements" / "README.md"
    for table in md_tables(req_md.read_text(encoding="utf-8")) if req_md.is_file() else []:
        if tuple(c.lower() for c in table[0][: len(REQ_HEADER)]) != REQ_HEADER:
            continue
        for row in table[1:]:
            rid = plain_id(row[0])
            if not REQ_ID_RE.match(rid):
                problems.append(f"requirements: {rid!r} is not an ID like REQ-USB-01")
                continue
            if rid in requirements:
                problems.append(f"requirements: {rid} twice")
            empty = [
                REQ_HEADER[i] for i in range(1, len(REQ_HEADER)) if i >= len(row) or not row[i].strip("—- ")
            ]
            if empty:
                problems.append(f"requirements: {rid} has no {', '.join(empty)}")
            methods = {m.strip().lower() for m in (row[4] if len(row) > 4 else "").split(",") if m.strip()}
            if methods - VERIFY_METHODS:
                problems.append(
                    f"requirements: {rid} method {', '.join(sorted(methods - VERIFY_METHODS))} "
                    f"is not one of {', '.join(sorted(VERIFY_METHODS))}"
                )
            requirements[rid] = row
    if req_md.is_file() and not requirements:
        problems.append("requirements: no table with the header " + " | ".join(REQ_HEADER))

    sim = gate_sim(project, out)
    decks = sim.details.get("decks", {})
    measures = {f"{d}.{k}": v for d, info in decks.items() for k, v in info.get("measures", {}).items()}
    problems += [f"sim: {f}" for f in sim.details.get("failures", [])]

    # Every deck has a writeup, and every writeup has its sections and names a deck.
    deck_names = set(decks)
    explained: set[str] = set()
    writeups = sorted(package.glob("simulations/*/README.md"))
    for md in writeups:
        if md.parent.name == DECK_TEMPLATE.parent.name:
            continue
        text = md.read_text(encoding="utf-8")
        names = {d for d in deck_names if f"sim/{d}.cir" in text}
        if not names:
            problems.append(f"{md.relative_to(package)}: names no sim/<deck>.cir")
        explained |= names
        heads = headings(text)
        missing = [s for s in SIM_SECTIONS if not any(s in h for h in heads)]
        if missing:
            problems.append(f"{md.relative_to(package)}: no section for {', '.join(missing)}")
    for d in sorted(deck_names - explained):
        problems.append(f"sim/{d}.cir: no writeup in simulations/ explains it")

    system = package / "system" / "README.md"
    if system.is_file() and not re.search(r"!\[[^\]]*\]\([^)]+\)", system.read_text(encoding="utf-8")):
        problems.append("system/README.md: no block diagram image")

    # Every number quoted beside a `deck.meas` in a table is the number this run gives.
    quoted = 0
    for md in mds:
        if md.name == "traceability.md":
            continue
        for table in md_tables(md.read_text(encoding="utf-8")):
            for row in table:
                for i, cell in enumerate(row):
                    name = code_span(cell)
                    if not name or not MEAS_NAME_RE.match(name) or name.split(".")[0] not in deck_names:
                        continue
                    if name.split(".")[1] in FILE_SUFFIXES:
                        continue
                    if name not in measures:
                        problems.append(f"{md.relative_to(package)}: {name} is not measured by its deck")
                        break
                    for later in row[i + 1 :]:
                        ok = quoted_matches(later, measures[name])
                        if ok is None:
                            continue
                        quoted += 1
                        if not ok:
                            problems.append(
                                f"{md.relative_to(package)}: {name} quoted as {later}, "
                                f"the run gives {measures[name]:.6g}"
                            )
                        break
                    break

    # The traceability table: every requirement, its check recomputed, its verdict the check's.
    verdicts = {v: [] for v in VERDICTS}
    traced: set[str] = set()
    trace = package / "traceability.md"
    for table in md_tables(trace.read_text(encoding="utf-8")) if trace.is_file() else []:
        if tuple(c.lower() for c in table[0][: len(TRACE_HEADER)]) != TRACE_HEADER:
            continue
        for row in table[1:]:
            row = row + [""] * (len(TRACE_HEADER) - len(row))
            rid, check, evidence, measured, verdict = (
                plain_id(row[0]),
                row[1],
                row[2],
                row[3],
                plain_id(row[4]).upper(),
            )
            if rid not in requirements:
                problems.append(f"traceability: {rid} is not in the requirements")
                continue
            traced.add(rid)
            if verdict not in VERDICTS:
                problems.append(f"traceability: {rid} verdict {verdict!r} is not PASS, FAIL or OPEN")
                continue
            if not LINK_RE.search(evidence):
                problems.append(f"traceability: {rid} links no evidence")
            verdicts[verdict].append(rid)
            expr = code_span(check)
            parsed = parse_check(expr) if expr else None
            if expr and parsed is None:
                problems.append(f"traceability: {rid} check `{expr}` is not `deck.meas <= value`")
            if not parsed:
                continue
            name, comparisons = parsed
            if name not in measures:
                problems.append(f"traceability: {rid} checks {name}, which no deck measures")
                continue
            value = measures[name]
            ok = quoted_matches(measured, value)
            if ok is None:
                problems.append(f"traceability: {rid} quotes no measured value for {name}")
            elif not ok:
                problems.append(
                    f"traceability: {rid} quotes {measured} for {name}, the run gives {value:.6g}"
                )
            else:
                quoted += 1
            computed = "PASS" if check_holds(comparisons, value) else "FAIL"
            if verdict != computed:
                problems.append(
                    f"traceability: {rid} says {verdict}, `{expr}` with {value:.6g} is {computed}"
                )
    for rid in sorted(set(requirements) - traced):
        problems.append(f"traceability: {rid} has no row")

    # A bound in an expect file that names a requirement names one that exists.
    sim_dir = project.dir / "sim"
    for exp in sorted(sim_dir.glob("*.expect.json")) if sim_dir.is_dir() else []:
        for meas, bounds in load_json(exp).items():
            req = bounds.get("req") if isinstance(bounds, dict) else None
            if req and req not in requirements:
                problems.append(f"{exp.name}: {meas} names {req}, which is not a requirement")

    failures = list(problems)
    if strict:
        failures += [f"{rid}: FAIL" for rid in verdicts["FAIL"]] + [
            f"{rid}: OPEN" for rid in verdicts["OPEN"]
        ]
    counts = ", ".join(f"{len(verdicts[v])} {v.lower()}" for v in VERDICTS)
    summary = f"{len(requirements)} requirements: {counts}; {quoted} quoted values match the run"
    if verdicts["FAIL"]:
        summary += f"; failing {', '.join(verdicts['FAIL'][:6])}" + (
            " ..." if len(verdicts["FAIL"]) > 6 else ""
        )
    if problems:
        summary += f"; {len(problems)} problems"
    result = Result(
        "verify",
        "fail" if failures else "pass",
        summary,
        {
            "package": str(package),
            "requirements": len(requirements),
            "verdicts": verdicts,
            "quoted": quoted,
            "writeups": len([w for w in writeups if w.parent.name != DECK_TEMPLATE.parent.name]),
            "decks": sorted(deck_names),
            "created": created,
            "failures": failures,
        },
        sim.artifacts,
    )
    return result


def cmd_verify(args) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    package = Path(args.package).resolve() if args.package else None
    result = gate_verify(project, out, package, args.init, args.strict)
    out.mkdir(parents=True, exist_ok=True)
    (out / "verify.json").write_text(json.dumps(asdict(result), indent=2), encoding="utf-8")
    return emit([result], args, None)


@timed
def gate_export(project: Project, out: Path, strict: bool = False, step: bool = False) -> Result:
    if not project.pcb:
        return Result("export", "skip", "no board in project")
    fab = out / "fab"
    fab.mkdir(parents=True, exist_ok=True)
    gerbers = fab / "gerbers"
    gerbers.mkdir(exist_ok=True)
    jobs: list[tuple[str, list[str], Path]] = [
        ("gerbers", [KICAD_CLI, "pcb", "export", "gerbers", "--output", f"{gerbers}/", project.pcb], gerbers),
        ("drill", [KICAD_CLI, "pcb", "export", "drill", "--output", f"{gerbers}/", project.pcb], gerbers),
    ]
    if project.sch:
        jobs.append(
            (
                "bom",
                [KICAD_CLI, "sch", "export", "bom", "--output", fab / "bom.csv", project.sch],
                fab / "bom.csv",
            )
        )
        jobs.append(
            (
                "schematic-pdf",
                [KICAD_CLI, "sch", "export", "pdf", "--output", fab / "schematic.pdf", project.sch],
                fab / "schematic.pdf",
            )
        )
    if step:
        jobs.append(
            (
                "step",
                [KICAD_CLI, "pcb", "export", "step", "--output", fab / f"{project.name}.step", project.pcb],
                fab / f"{project.name}.step",
            )
        )
    details, artifacts, failures = {}, [], []
    for name, cmd, expect in jobs:
        proc = run(cmd, cwd=project.dir)
        produced = expect.is_file() if expect.suffix else any(expect.iterdir())
        ok = proc.returncode == 0 and produced
        details[name] = {
            "exit": proc.returncode,
            "produced": produced,
            "stderr": proc.stderr[-800:] if not ok else "",
        }
        if ok:
            artifacts.append(str(expect))
        else:
            failures.append(name)
    gerber_files = sorted(p.name for p in gerbers.iterdir()) if gerbers.is_dir() else []
    details["gerber_files"] = gerber_files
    return Result(
        "export",
        "fail" if failures else "pass",
        f"{len(jobs) - len(failures)}/{len(jobs)} outputs, {len(gerber_files)} gerber files",
        details,
        artifacts,
    )


@timed
def gate_autoroute(
    project: Project,
    out: Path,
    dsn: str | None = None,
    passes: int = 20,
    threads: int = 0,
    timeout: int = 600,
) -> Result:
    if not project.pcb:
        return Result("autoroute", "skip", "no board in project")
    if not FREEROUTING_JAR.is_file():
        return Result("autoroute", "skip", f"engine missing: {FREEROUTING_JAR}")
    if not shutil.which(JAVA):
        return Result("autoroute", "skip", f"engine missing: {JAVA}")
    # kicad-cli 10 has no Specctra export. The DSN comes from KiCad
    # (File > Export > Specctra DSN) next to the board, or from --dsn.
    candidates = (
        [Path(dsn)] if dsn else [project.dir / f"{project.name}.dsn", out / "route" / f"{project.name}.dsn"]
    )
    dsn_path = next((c for c in candidates if c.is_file()), None)
    if dsn_path is None:
        return Result(
            "autoroute",
            "skip",
            "no Specctra DSN: kicad-cli 10 cannot export one; export it from KiCad or pass --dsn",
            {"looked_for": [str(c) for c in candidates]},
        )
    route = out / "route"
    route.mkdir(parents=True, exist_ok=True)
    ses = route / f"{project.name}.ses"
    cmd = [JAVA, "-jar", FREEROUTING_JAR, "-de", dsn_path, "-do", ses, "-mp", str(passes)]
    if threads:
        cmd += ["-mt", str(threads)]
    proc = run(cmd, cwd=route, timeout=timeout)
    if proc.returncode != 0 or not ses.is_file():
        return Result(
            "autoroute",
            "fail",
            f"FreeRouting exited {proc.returncode}",
            {"stderr": (proc.stderr or proc.stdout)[-1500:]},
        )
    return Result(
        "autoroute",
        "pass",
        f"session file written: {ses.name}",
        {
            "note": "import the .ses into the board with KiCad (File > Import > Specctra Session), "
            "then run drc"
        },
        [str(dsn_path), str(ses)],
    )


def footprint_blocks(text: str) -> list[str]:
    """The top-level `(footprint ...)` nodes of a .kicad_pcb, as text, read by bracket depth with
    quoted strings skipped, so a bracket inside a property value cannot cut a block short."""
    blocks: list[str] = []
    depth, start, i, quoted = 0, -1, 0, False
    while i < len(text):
        ch = text[i]
        if quoted:
            if ch == "\\":
                i += 1
            elif ch == '"':
                quoted = False
        elif ch == '"':
            quoted = True
        elif ch == "(":
            depth += 1
            if depth == 2 and text.startswith("(footprint ", i):
                start = i
        elif ch == ")":
            if depth == 2 and start >= 0:
                blocks.append(text[start : i + 1])
                start = -1
            depth -= 1
        i += 1
    return blocks


def parts_without_body(project: Project) -> list[dict]:
    """Parts whose footprint names 3D models of which none exists on disk: the 3D views draw their pads
    bare. Paths resolve the way KiCad's do: ${KIPRJMOD} is the project folder, a ${KICADn_3DMODEL_DIR}
    is that environment variable or the installed library."""
    QUOTED = r'"((?:[^"\\]|\\.)*)"'

    def resolve(path: str) -> Path:
        def var(m: re.Match) -> str:
            name = m.group(1)
            if name == "KIPRJMOD":
                return str(project.dir)
            if name.endswith("3DMODEL_DIR"):
                return os.environ.get(name, DEFAULT_3DMODEL_DIR)
            return os.environ.get(name, m.group(0))

        p = Path(re.sub(r"\$\{(\w+)\}", var, path))
        return p if p.is_absolute() else project.dir / p

    bare = []
    for block in footprint_blocks(project.pcb.read_text(encoding="utf-8")):
        models = re.findall(r"\(model " + QUOTED, block)
        if not models or any(resolve(m).is_file() for m in models):
            continue
        ref = re.search(r'\(property "Reference" ' + QUOTED, block)
        lib = re.match(r"\(footprint " + QUOTED, block)
        bare.append(
            {"ref": ref.group(1) if ref else "?", "footprint": lib.group(1) if lib else "?", "models": models}
        )
    return bare


def copper_layers(pcb: Path) -> list[str]:
    """The board's copper layers, top to bottom, as its layer table lists them."""
    text = pcb.read_text(encoding="utf-8", errors="replace")
    table = re.search(r"\(layers\s*((?:\(\s*\d+\s+\"[^\"]+\"[^()]*\)\s*)+)\)", text)
    return re.findall(r"\(\s*\d+\s+\"([^\"]+\.Cu)\"", table.group(1)) if table else []


def png_size(png: Path) -> tuple[int, int]:
    """Width and height from a PNG's header."""
    head = png.read_bytes()[:24]
    return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")


def layer_sheet(plotted: list[tuple[str, Path]], rdir: Path) -> tuple[Path, int]:
    """An SVG that lays the layer images out in a grid, each under its name, for rsvg-convert to flatten.
    The images are referenced from `layers/`, below the sheet, which librsvg allows."""
    w0, h0 = png_size(plotted[0][1])
    cols = max(1, min(len(plotted), round(math.sqrt(len(plotted) * 1.6 * h0 / w0))))
    cell_w = 600 if w0 >= h0 else 250
    cell_h = max(round(cell_w * png_size(p)[1] / png_size(p)[0]) for _, p in plotted)
    label, gap = 22, 14
    rows = math.ceil(len(plotted) / cols)
    width, height = cols * cell_w + (cols + 1) * gap, rows * (cell_h + label) + (rows + 1) * gap
    parts = [
        f'<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
        f'width="{width}" height="{height}">',
        f'<rect width="{width}" height="{height}" fill="{LAYER_BACKGROUND}"/>',
    ]
    for i, (layer, png) in enumerate(plotted):
        x = gap + (i % cols) * (cell_w + gap)
        y = gap + (i // cols) * (cell_h + label + gap)
        name = layer + (", from below" if layer.startswith("B.") else "")
        w, h = png_size(png)
        parts.append(
            f'<text x="{x}" y="{y + 16}" fill="#e8e8e8" font-family="DejaVu Sans, sans-serif" '
            f'font-size="15">{name}</text>'
        )
        parts.append(
            f'<image x="{x}" y="{y + label}" width="{cell_w}" height="{round(cell_w * h / w)}" '
            f'xlink:href="layers/{png.name}"/>'
        )
    sheet = rdir / "layers.svg"
    sheet.write_text("\n".join([*parts, "</svg>"]) + "\n", encoding="utf-8")
    return sheet, width


@timed
def gate_render(
    project: Project,
    out: Path,
    width: int = 1600,
    views: tuple[str, ...] = DEFAULT_VIEWS,
    spin_frames: int = 36,
    spin_tilt: float = -55.0,
    spin_zoom: float = 1.0,
    spin_pivot: str | None = None,
    strict: bool = False,
) -> Result:
    """Images of the design: schematic, board top and bottom (2D), board 3D top, bottom and isometric,
    every layer on its own with an overview sheet, and on request a GIF that turns the 3D board round.
    The record names each part the 3D views draw bare (`parts_without_body`); `strict` fails on one."""
    rdir = out / "render"
    rdir.mkdir(parents=True, exist_ok=True)
    artifacts: list[str] = []
    failures: list[str] = []
    skipped: list[str] = []
    rsvg = shutil.which("rsvg-convert")

    def to_png(svg: Path, png: Path, w: int, background: str = "white") -> bool:
        if not rsvg:
            skipped.append(f"{png.name}: rsvg-convert missing")
            return False
        proc = run([rsvg, "-w", str(w), "-b", background, "-o", png, svg])
        if proc.returncode == 0 and png.is_file():
            artifacts.append(str(png))
            return True
        failures.append(png.name)
        return False

    def render_3d(png: Path, w: int, extra: list[str]) -> bool:
        cmd = [
            KICAD_CLI,
            "pcb",
            "render",
            "--output",
            png,
            "--width",
            str(w),
            "--height",
            str(int(w * 0.625)),
            "--background",
            "opaque",
            "--quality",
            "high",
            *extra,
            project.pcb,
        ]
        if not os.environ.get("DISPLAY") and shutil.which("xvfb-run"):
            cmd = ["xvfb-run", "-a", *cmd]
        proc = run(cmd, cwd=project.dir, timeout=300)
        return proc.returncode == 0 and png.is_file()

    def plot_svg(svg: Path, layers: str, extra: list[str]) -> bool:
        proc = run(
            [
                KICAD_CLI,
                "pcb",
                "export",
                "svg",
                "--output",
                svg,
                "--layers",
                layers,
                "--page-size-mode",
                "2",
                "--mode-single",
                "--exclude-drawing-sheet",
                *extra,
                project.pcb,
            ],
            cwd=project.dir,
        )
        return proc.returncode == 0 and svg.is_file()

    if project.sch and "schematic" in views:
        before = set(rdir.glob("*.svg"))
        proc = run(
            [
                KICAD_CLI,
                "sch",
                "export",
                "svg",
                "--output",
                f"{rdir}/",
                "--no-background-color",
                "--exclude-drawing-sheet",
                project.sch,
            ],
            cwd=project.dir,
        )
        new = sorted(set(rdir.glob("*.svg")) - before, key=lambda p: p.stat().st_mtime)
        if proc.returncode == 0 and new:
            svg = new[-1].replace(rdir / "schematic.svg")
            artifacts.append(str(svg))
            to_png(svg, rdir / "schematic.png", width * 2)
        else:
            failures.append("schematic.svg")
    if project.pcb and "2d" in views:
        for name, layers, extra in (
            ("board-top", "F.Cu,F.SilkS,F.Mask,Edge.Cuts", []),
            ("board-bottom", "B.Cu,B.SilkS,B.Mask,Edge.Cuts", ["--mirror"]),
        ):
            svg = rdir / f"{name}.svg"
            if plot_svg(svg, layers, extra):
                artifacts.append(str(svg))
                to_png(svg, rdir / f"{name}.png", width)
            else:
                failures.append(svg.name)
    if project.pcb and "3d" in views:
        for name, extra in (
            ("board-3d-top", []),
            ("board-3d-bottom", ["--side", "bottom"]),
            ("board-3d-iso", ["--rotate", "-35,0,25", "--perspective"]),
        ):
            png = rdir / f"{name}.png"
            if render_3d(png, width, extra):
                artifacts.append(str(png))
            else:
                failures.append(png.name)
    if project.pcb and "layers" in views:
        ldir = rdir / "layers"
        shutil.rmtree(ldir, ignore_errors=True)
        ldir.mkdir()
        plotted: list[tuple[str, Path]] = []
        for layer in [*copper_layers(project.pcb), *LAYER_IMAGES]:
            # Drawn on its own without drill holes, which show on every layer: an empty layer draws
            # nothing and gets no image. A layer the board does not have writes no file.
            probe = ldir / "probe.svg"
            drawn = plot_svg(probe, layer, ["--drill-shape-opt", "0"]) and bool(
                DRAWN.search(probe.read_text(encoding="utf-8", errors="replace"))
            )
            probe.unlink(missing_ok=True)
            if not drawn:
                continue
            name = layer.replace(".", "-")
            svg = ldir / f"{name}.svg"
            both = layer if layer == "Edge.Cuts" else f"{layer},Edge.Cuts"
            if not plot_svg(svg, both, ["--mirror"] if layer.startswith("B.") else []):
                failures.append(f"layers/{name}.png")
                continue
            if to_png(svg, ldir / f"{name}.png", width, LAYER_BACKGROUND):
                plotted.append((layer, ldir / f"{name}.png"))
            svg.unlink()
        if plotted:
            sheet, sheet_w = layer_sheet(plotted, rdir)
            to_png(sheet, rdir / "layers.png", sheet_w, LAYER_BACKGROUND)
            sheet.unlink()
    if project.pcb and "spin" in views:
        ffmpeg = shutil.which("ffmpeg")
        gif = rdir / "board-spin.gif"
        if not ffmpeg:
            skipped.append(f"{gif.name}: ffmpeg missing")
        else:
            frames = rdir / "spin-frames"
            shutil.rmtree(frames, ignore_errors=True)
            frames.mkdir()
            # Turned about the board's normal, tilted toward the viewer; the GIF loops at 12 frames a second.
            ok = all(
                render_3d(
                    frames / f"{i:03d}.png",
                    min(width, SPIN_WIDTH),
                    [
                        "--rotate",
                        f"{spin_tilt:g},0,{360 * i / spin_frames:.2f}",
                        "--perspective",
                        "--zoom",
                        f"{spin_zoom:g}",
                        *(["--pivot", spin_pivot] if spin_pivot else []),
                    ],
                )
                for i in range(spin_frames)
            )
            if ok:
                palette = "split[a][b];[a]palettegen=stats_mode=full[p];[b][p]paletteuse=dither=sierra2_4a"
                proc = run(
                    [
                        ffmpeg,
                        "-y",
                        "-loglevel",
                        "error",
                        "-framerate",
                        "12",
                        "-i",
                        frames / "%03d.png",
                        "-vf",
                        palette,
                        "-loop",
                        "0",
                        gif,
                    ]
                )
                ok = proc.returncode == 0 and gif.is_file()
            if ok:
                artifacts.append(str(gif))
            else:
                failures.append(gif.name)
            shutil.rmtree(frames, ignore_errors=True)
    if not artifacts:
        return Result("render", "skip", "nothing rendered", {"failures": failures, "skipped": skipped})
    bare = parts_without_body(project) if project.pcb and {"3d", "spin"} & set(views) else []
    summary = f"{len(artifacts)} images in {rdir}" + (f", {len(skipped)} skipped" if skipped else "")
    if bare:
        summary += f"; {len(bare)} parts drawn without a 3D body: {', '.join(b['ref'] for b in bare)}"
    return Result(
        "render",
        "fail" if failures or (strict and bare) else "pass",
        summary,
        {"failures": failures, "skipped": skipped, "no_body": bare},
        artifacts,
    )


# ------------------------------------------------------------- procurement

PARTS_COLUMNS = ("Value", "Footprint", "Qty", "Manufacturer", "MPN", "Supplier", "SKU", "Pack", "Breaks")
STALE_DAYS = 90  # a price older than this is a warning (a failure with --strict)
CENT = Decimal("0.01")


@dataclass
class PartRow:
    """One row of a parts file: what to buy for a BOM line (Value and Footprint), or an item off the
    board (no Footprint, Qty per unit). Supplier "none" marks a line that is copper, nothing to buy."""

    value: str
    footprint: str
    qty: int
    manufacturer: str
    mpn: str
    supplier: str
    sku: str
    pack: int
    breaks: list[tuple[int, Decimal]]
    stock: int | None
    checked: str
    url: str
    note: str
    source: str  # file:line, for messages

    @property
    def buys(self) -> bool:
        return self.supplier.lower() != "none"


def parse_breaks(text: str) -> list[tuple[int, Decimal]]:
    """'1:0.10 10:0.021' -> [(1, 0.10), (10, 0.021)]: quantity and unit price, quantities rising."""
    breaks = []
    for item in text.split():
        qty, sep, price = item.partition(":")
        try:
            q, p = int(qty.replace(",", "")), Decimal(price.lstrip("$"))
        except (ValueError, InvalidOperation):
            raise ValueError(f"price break {item!r} is not QTY:PRICE") from None
        if not sep or q < 1 or p < 0 or (breaks and q <= breaks[-1][0]):
            raise ValueError(
                f"price breaks {text!r}: quantities rise from 1 or more, prices are not negative"
            )
        breaks.append((q, p))
    return breaks


def read_parts(path: Path) -> list[PartRow]:
    rows = []
    with path.open(encoding="utf-8", newline="") as fh:
        reader = csv.DictReader(fh)
        missing = [c for c in PARTS_COLUMNS if c not in (reader.fieldnames or [])]
        if missing:
            raise ValueError(f"{path}: no column {', '.join(missing)}")
        for n, r in enumerate(reader, start=2):
            where = f"{path.name}:{n}"
            try:
                stock = r.get("Stock", "").replace(",", "").strip()
                rows.append(
                    PartRow(
                        value=r["Value"].strip(),
                        footprint=r["Footprint"].strip(),
                        qty=int(r["Qty"]) if r["Qty"].strip() else 0,
                        manufacturer=r["Manufacturer"].strip(),
                        mpn=r["MPN"].strip(),
                        supplier=r["Supplier"].strip(),
                        sku=r["SKU"].strip(),
                        pack=int(r["Pack"]) if r["Pack"].strip() else 1,
                        breaks=parse_breaks(r["Breaks"]),
                        stock=int(stock) if stock else None,
                        checked=r.get("Checked", "").strip(),
                        url=r.get("URL", "").strip(),
                        note=r.get("Note", "").strip(),
                        source=where,
                    )
                )
            except ValueError as exc:
                raise ValueError(f"{where}: {exc}") from None
            if not rows[-1].footprint and rows[-1].qty < 1:
                raise ValueError(f"{where}: an item off the board needs Qty, the number per unit")
    return rows


def schematic_bom(project: Project, bom_csv: Path) -> tuple[list[dict] | None, str]:
    """The schematic's BOM grouped by value and footprint, DNP lines dropped: (rows, kicad-cli's
    stderr). Rows is None when kicad-cli wrote none."""
    proc = run(
        [
            KICAD_CLI,
            "sch",
            "export",
            "bom",
            "--fields",
            "Reference,Value,Footprint,${QUANTITY},${DNP}",
            "--group-by",
            "Value,Footprint",
            "--labels",
            "Refs,Value,Footprint,Qty,DNP",
            "--output",
            bom_csv,
            project.sch,
        ]
    )
    if proc.returncode != 0 or not bom_csv.is_file():
        return None, proc.stderr[-800:]
    with bom_csv.open(encoding="utf-8", newline="") as fh:
        return [r for r in csv.DictReader(fh) if not r.get("DNP", "").strip()], ""


def unit_price(breaks: list[tuple[int, Decimal]], qty: int) -> Decimal:
    """The price of the largest break at or below qty (the first break when qty is below it)."""
    price = breaks[0][1]
    for q, p in breaks:
        if q <= qty:
            price = p
    return price


def order_for(breaks: list[tuple[int, Decimal]], pack: int, need: int) -> tuple[int, Decimal]:
    """The cheapest order that covers `need`: at least the first break, in multiples of `pack`, and
    up to a higher break when buying more costs less in all. Returns (quantity, total)."""

    def up(q: int) -> int:
        return -(-q // pack) * pack

    candidates = {up(max(need, breaks[0][0]))} | {up(q) for q, _ in breaks if q > need}
    return min(((q, q * unit_price(breaks, q)) for q in candidates), key=lambda c: (c[1], c[0]))


def money(d: Decimal) -> str:
    return f"${d.quantize(CENT, rounding=ROUND_HALF_UP):,}"


@timed
def gate_procure(
    project: Project, out: Path, parts: list[Path], boards: tuple[int, ...] = (1, 10), strict: bool = False
) -> Result:
    """Price the schematic's BOM from parts files: every line matched to a part with its supplier and
    price breaks, the cheapest order for each board quantity, totals per supplier. Writes
    procure/bom.csv (the schematic's BOM, grouped), procure/parts.csv and procure/parts.md."""
    if not project.sch:
        return Result("procure", "skip", "no schematic in project")
    if not parts:
        return Result(
            "procure", "skip", f"no parts file: name one with --parts or add {project.dir / 'parts.csv'}"
        )
    pdir = out / "procure"
    pdir.mkdir(parents=True, exist_ok=True)
    bom_csv = pdir / "bom.csv"
    bom, stderr = schematic_bom(project, bom_csv)
    if bom is None:
        return Result("procure", "error", "kicad-cli wrote no BOM", {"stderr": stderr})
    try:
        rows = [r for p in parts for r in read_parts(p)]
    except (OSError, ValueError) as exc:
        return Result("procure", "error", str(exc))

    lines = []  # (refs, qty, PartRow | None, value, footprint)
    for b in bom:
        match = next(
            (r for r in rows if r.footprint and r.value == b["Value"] and r.footprint == b["Footprint"]), None
        )
        lines.append((b["Refs"], int(b["Qty"]), match, b["Value"], b["Footprint"]))
    for r in rows:
        if not r.footprint:
            lines.append(("", r.qty, r, r.value, ""))

    unmatched = [f"{refs} {value} {fp}" for refs, _, m, value, fp in lines if m is None]
    unpriced = [
        f"{refs or value}: {m.mpn or 'no part chosen'}, "
        + (f"at {m.supplier}" if m.supplier else "no supplier")
        for refs, _, m, value, _ in lines
        if m and m.buys and not m.breaks
    ]
    today = datetime.date.today()
    short, stale = [], []
    suppliers: list[str] = []
    totals = {n: {} for n in boards}
    priced = []
    for refs, qty, m, value, fp in lines:
        orders = {}
        if m and m.buys and m.breaks:
            if m.supplier not in suppliers:
                suppliers.append(m.supplier)
            for n in boards:
                q, cost = order_for(m.breaks, m.pack, qty * n)
                orders[n] = (q, cost)
                totals[n][m.supplier] = totals[n].get(m.supplier, Decimal(0)) + cost
            need = qty * max(boards)
            if m.stock is not None and m.stock < need:
                short.append(
                    f"{refs or value}: {m.stock} in stock at {m.supplier}, {need} needed for {max(boards)}"
                )
            try:
                age = (today - datetime.date.fromisoformat(m.checked)).days
            except ValueError:
                age = None
            if age is None or age > STALE_DAYS:
                stale.append(f"{refs or value}: price checked {m.checked or 'on no date'}")
        priced.append((refs, qty, m, value, fp, orders))

    with (pdir / "parts.csv").open("w", encoding="utf-8", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(
            [
                "Refs",
                "Qty",
                "Value",
                "Footprint",
                "Manufacturer",
                "MPN",
                "Supplier",
                "SKU",
                "Stock",
                "Checked",
                "URL",
                "Note",
            ]
            + [h for n in boards for h in (f"Order for {n}", f"Cost for {n}")]
        )
        for refs, qty, m, value, fp, orders in priced:
            w.writerow(
                [refs, qty, value, fp]
                + (
                    [
                        m.manufacturer,
                        m.mpn,
                        m.supplier,
                        m.sku,
                        "" if m.stock is None else m.stock,
                        m.checked,
                        m.url,
                        m.note,
                    ]
                    if m
                    else [""] * 8
                )
                + [
                    x
                    for n in boards
                    for x in ((orders[n][0], f"{orders[n][1]:.2f}") if n in orders else ("", ""))
                ]
            )

    def row_md(refs, qty, m, value) -> str:
        if m is None:
            return f"| {refs} | {qty} | {value} | not in the parts files | | | | | | |"
        part = (
            (f"{m.manufacturer} {m.mpn}".strip() or "no part chosen") if m.buys else "nothing to buy: copper"
        )
        link = f"[{m.sku}]({m.url})" if m.url and m.sku else (m.sku or "")
        unit = money(unit_price(m.breaks, 1)) if m.breaks else ("" if not m.buys else "not priced")
        stock = "" if m.stock is None else f"{m.stock:,}"
        note = m.note.replace("|", "/")
        cells = [
            refs,
            qty,
            value,
            part,
            m.supplier if m.buys else "",
            link,
            unit,
            stock,
        ]
        return "| " + " | ".join(str(c) for c in [*cells, m.checked, note]) + " |"

    columns = (
        "Refs",
        "Qty",
        "Value",
        "Part",
        "Supplier",
        "Supplier number",
        "Unit at 1",
        "Stock",
        "Checked",
        "Note",
    )
    head = "| " + " | ".join(columns) + " |\n" + "|---" * len(columns) + "|"
    md = [
        f"# Parts: {project.name}",
        "",
        f"From the schematic (`{project.sch.name}`, grouped by value and footprint) and "
        + ", ".join(f"`{p.name}`" for p in parts)
        + ". Prices in USD, as each supplier's page showed them on the date in the row,"
        " before shipping and tax.",
        "",
        "## On the board",
        "",
        head,
        *[row_md(refs, qty, m, value) for refs, qty, m, value, fp, _ in priced if fp],
        "",
    ]
    off = [row_md(refs, qty, m, value) for refs, qty, m, value, fp, _ in priced if not fp]
    if off:
        md += ["## Off the board, per unit", "", head, *off, ""]
    md += [
        "## Cost",
        "",
        "| Units | " + " | ".join(suppliers) + " | Total | Per unit |",
        "|---" * (len(suppliers) + 3) + "|",
    ]
    for n in boards:
        total = sum(totals[n].values(), Decimal(0))
        md.append(
            f"| {n} | "
            + " | ".join(money(totals[n].get(s, Decimal(0))) for s in suppliers)
            + f" | {money(total)} | {money(total / n)} |"
        )
    md += [
        "",
        "Each line orders the cheapest quantity that covers the need: at least the first price break,"
        " in whole "
        "packs, and more where a higher break costs less in all.",
        "",
    ]
    for title, items in (
        ("Not in the parts files", unmatched),
        ("Not priced", unpriced),
        ("Short of stock", short),
        ("Prices to check again", stale),
    ):
        if items:
            md += [f"## {title}", "", *[f"- {i}" for i in items], ""]
    (pdir / "parts.md").write_text("\n".join(md), encoding="utf-8")

    n_max = max(boards)
    total_max = sum(totals[n_max].values(), Decimal(0))
    n_priced = len(lines) - len(unmatched) - len(unpriced)
    summary = f"{len(lines)} lines, {n_priced} priced; {n_max} units {money(total_max)}"
    if unmatched or unpriced:
        summary += f"; {len(unmatched)} not in the parts files, {len(unpriced)} not priced"
    if short or stale:
        summary += f"; {len(short)} short of stock, {len(stale)} prices to check again"
    failed = unmatched or unpriced or (strict and (short or stale))
    return Result(
        "procure",
        "fail" if failed else "pass",
        summary,
        {
            "unmatched": unmatched,
            "unpriced": unpriced,
            "short": short,
            "stale": stale,
            "totals": {str(n): {s: f"{c:.2f}" for s, c in totals[n].items()} for n in boards},
        },
        [str(bom_csv), str(pdir / "parts.csv"), str(pdir / "parts.md")],
    )


def board_counts(value: str) -> tuple[int, ...]:
    try:
        counts = tuple(int(v) for v in value.split(",") if v.strip())
    except ValueError:
        counts = ()
    if not counts or min(counts) < 1:
        raise argparse.ArgumentTypeError(f"--boards takes counts like 1,10, not {value!r}")
    return counts


def cmd_procure(args) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    parts = [Path(p).resolve() for p in args.parts] if args.parts else []
    if not parts and (project.dir / "parts.csv").is_file():
        parts = [project.dir / "parts.csv"]
    return emit([gate_procure(project, out, parts, args.boards, args.strict)], args, None)


# ----------------------------------------------------------------- sources

SOURCES_COLUMNS = ("MPN", "Kind", "URL", "File", "Revision")
SOURCE_KINDS = ("datasheet", "spice", "step")
# Reference letters of the parts a circuit simulation needs a model for: each needs a spice row,
# with a file or a note saying why there is none.
SIMULATED_REFS = ("U", "Q", "D")


def needs_model(ref: str) -> bool:
    """Whether a part needs a spice row, by its reference's whole letter prefix: D1 is a diode,
    DS1 a display."""
    letters = re.match(r"[A-Za-z]+", ref)
    return bool(letters) and letters.group(0).upper() in SIMULATED_REFS


# Who asks, said plainly; a refused fetch is the supplier's answer and is never retried disguised.
FETCH_AGENT = "EE-Workcenter/1 (+https://github.com/ThyFriendlyFox/workspace-ee-test)"
SUBCKT_RE = re.compile(r"^\s*\.subckt\s+(\S+)(.*)$", re.IGNORECASE | re.MULTILINE)
INCLUDE_RE = re.compile(r"^\s*\.(?:include|inc|lib)\s+[\"']?([^\"'\s]+)", re.IGNORECASE | re.MULTILINE)
YEAR_RE = re.compile(r"(?<!\d)(19[89]\d|20\d\d)(?!\d)")
# The Ngspice column: a compatibility mode for ngspice's ngbehavior, and the fixes translate_model
# applies to a copy in the output directory (the library's file stays as the vendor wrote it).
NGSPICE_MODES = ("ps", "psa", "lt", "lta", "ltps", "ltpsa", "ki", "a")
MODEL_FIXES = ("res-model", "tolerance")
TOLERANCE_RE = re.compile(r"\b(?:LOT|DEV)(?:/\d+)?(?:/(?:UNIFORM|GAUSS|WCASE))?\s*=\s*[\d.]+%?", re.I)
RES_MODEL_RE = re.compile(r"^\s*\.model\s+(\S+)\s+RES\b\s*\(?([^)\n]*)\)?", re.I | re.M)
HEADER_RE = re.compile(r"\b(version|revision|rev\b|date|created|copyright|released)", re.IGNORECASE)


@dataclass
class SourceRow:
    """One row of a library's sources.csv: where a part's datasheet, SPICE model or 3D body came from,
    the file kept for it (relative to sources.csv), and what that file must hold."""

    mpn: str
    kind: str  # datasheet | spice | step
    url: str
    file: str  # empty: none exists, and the note says why
    member: str  # the file inside a zip at URL
    revision: str  # the revision as the file prints it
    dated: str  # the revision's year (or YYYY-MM), for the model-against-datasheet check
    subckt: str  # spice: the .SUBCKT the decks use
    ngspice: str  # spice: the compatibility mode ngspice needs (ps, lt, ...), empty for none
    sha256: str
    checked: str
    note: str
    source: str  # file:line


def read_sources(path: Path) -> list[SourceRow]:
    rows = []
    with path.open(encoding="utf-8", newline="") as fh:
        reader = csv.DictReader(fh)
        missing = [c for c in SOURCES_COLUMNS if c not in (reader.fieldnames or [])]
        if missing:
            raise ValueError(f"{path}: no column {', '.join(missing)}")
        for n, raw in enumerate(reader, start=2):
            where = f"{path.name}:{n}"
            if raw.get(None):  # DictReader keeps a row's fields past the header under None
                raise ValueError(
                    f"{where}: {len(raw[None])} more field(s) than the header: an unquoted comma in a cell?"
                )
            cells = {k: (v or "").strip() for k, v in raw.items() if k}

            def cell(name: str, cells: dict = cells) -> str:
                return cells.get(name, "")

            row = SourceRow(
                mpn=cell("MPN"),
                kind=cell("Kind").lower(),
                url=cell("URL"),
                file=cell("File"),
                member=cell("Member"),
                revision=cell("Revision"),
                dated=cell("Dated"),
                subckt=cell("Subckt"),
                ngspice=cell("Ngspice"),
                sha256=cell("SHA256").lower(),
                checked=cell("Checked"),
                note=cell("Note"),
                source=where,
            )
            if not row.mpn:
                raise ValueError(f"{where}: no MPN")
            if row.kind not in SOURCE_KINDS:
                raise ValueError(f"{where}: Kind {row.kind!r} is not one of {', '.join(SOURCE_KINDS)}")
            if not row.file and not row.note:
                raise ValueError(f"{where}: a row without a File needs a Note saying why there is none")
            ngspice_mode(row)  # a bad Ngspice cell is an error here, not at simulation time
            rows.append(row)
    return rows


def ngspice_mode(row: SourceRow) -> tuple[str, set[str]]:
    """The row's Ngspice cell: (compatibility mode or "", fixes)."""
    mode, fixes = "", set()
    for tok in row.ngspice.split():
        t = tok.lower()
        if t in NGSPICE_MODES and not mode:
            mode = t
        elif t in MODEL_FIXES:
            fixes.add(t)
        else:
            raise ValueError(
                f"{row.source}: Ngspice {tok!r} is not a mode ({', '.join(NGSPICE_MODES)}) "
                f"or a fix ({', '.join(MODEL_FIXES)})"
            )
    return mode, fixes


def translate_model(text: str, fixes: set[str]) -> str:
    """PSpice syntax that ngspice reads differently, rewritten. 'tolerance' drops LOT and DEV specs,
    which ngspice ignores with a warning each. 'res-model' folds a RES model into the resistors that
    name it: PSpice makes such a resistor its value times the model's R, ngspice takes the value
    alone (a 99.5 Ohm resistor becomes 1 Ohm); the model's TC1 and TC2 move to the instance."""
    if not fixes:
        return text
    text = re.sub(r"\n[ \t]*\+", " ", text)
    if "tolerance" in fixes:
        text = TOLERANCE_RE.sub("", text)
    if "res-model" in fixes:
        models = {
            m.group(1).upper(): {k.upper(): v for k, v in re.findall(r"(\w+)\s*=\s*([^\s)]+)", m.group(2))}
            for m in RES_MODEL_RE.finditer(text)
        }
        out = []
        for ln in text.splitlines():
            if RES_MODEL_RE.match(ln):
                out.append(f"* {ln.strip()}   (folded into the resistors that name it)")
                continue
            m = re.match(r"^(\s*R\S*\s+\S+\s+\S+)\s+(\S+)\s+(\S+)(.*)$", ln, re.I)
            if m and m.group(2).upper() in models:
                p = models[m.group(2).upper()]
                tc = "".join(f" {k.lower()}={p[k]}" for k in ("TC1", "TC2") if k in p)
                out.append(f"{m.group(1)} {{{p.get('R', '1')}*{m.group(3)}}}{tc}{m.group(4)}")
                continue
            out.append(ln)
        text = "\n".join(out) + "\n"
    return text


def find_sources(start: Path) -> Path | None:
    """The nearest library/sources.csv at or above `start`, up to the repository's root."""
    for d in (start, *start.parents):
        cand = d / "library" / "sources.csv"
        if cand.is_file():
            return cand
        if (d / ".git").exists():
            break
    return None


def file_sha256(path: Path) -> str:
    import hashlib

    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def normalized(text: str) -> str:
    """For finding a printed revision in extracted text: dashes, spaces and case made alike."""
    for dash in "‐‑‒–—−":
        text = text.replace(dash, "-")
    return re.sub(r"\s+", " ", text).casefold()


def file_text(path: Path) -> str | None:
    """The file's text: pdftotext for a PDF (None without it), the bytes as text otherwise."""
    if path.suffix.lower() == ".pdf":
        if not shutil.which("pdftotext"):
            return None
        proc = run(["pdftotext", "-q", path, "-"], timeout=120)
        return proc.stdout if proc.returncode == 0 else ""
    return path.read_text(encoding="utf-8", errors="replace")


def spice_facts(text: str) -> dict:
    """What a SPICE library defines and needs: subcircuits with their pins, model names, the files
    it includes, and the comment lines near its top that carry a version or a date."""
    joined = re.sub(r"\n[ \t]*\+", " ", text)  # continuation lines
    subckts = {}
    for m in SUBCKT_RE.finditer(joined):
        pins = []
        for tok in m.group(2).split():
            if tok.endswith(":") or "=" in tok or tok.lower().startswith("params"):
                break
            pins.append(tok)
        subckts[m.group(1).upper()] = pins
    models = sorted({m.upper() for m in re.findall(r"^\s*\.model\s+(\S+)", joined, re.I | re.M)})
    includes = INCLUDE_RE.findall(joined)
    header = []
    for ln in text.splitlines()[:80]:
        s = ln.strip()
        if s.startswith("*") and HEADER_RE.search(s):
            header.append(s.lstrip("* ").strip())
    return {"subckts": subckts, "models": models, "includes": includes, "header": header[:8]}


def prepared_model(row: SourceRow, path: Path, work: Path) -> Path:
    """The file ngspice should read for a row: the library's own, or a translated copy in `work`
    when the row lists fixes."""
    _, fixes = ngspice_mode(row)
    if not fixes:
        return path
    work.mkdir(parents=True, exist_ok=True)
    dest = work / f"{path.stem}.ngspice{path.suffix or '.lib'}"
    text = path.read_text(encoding="utf-8", errors="replace")
    dest.write_text(
        f"* {path.name} as ngspice reads it: {', '.join(sorted(fixes))} (workcenter translate_model)\n"
        + translate_model(text, fixes),
        encoding="utf-8",
    )
    return dest


def ngspice_load_errors(lib: Path, subckt: str, pins: list[str], row: SourceRow, work: Path) -> list[str]:
    """Load a subcircuit in ngspice: include the file (translated when the row lists fixes), place one
    instance with every pin tied to ground through 1 GOhm, and run no analysis. Returns ngspice's
    error lines (empty: it loaded)."""
    work.mkdir(parents=True, exist_ok=True)
    lib = prepared_model(row, lib, work)
    nodes = [f"n{i}" for i in range(len(pins))]
    deck = [f"* load check: {subckt} from {lib.name}", f'.include "{lib}"', f"X1 {' '.join(nodes)} {subckt}"]
    deck += [f"R{i} {n} 0 1G" for i, n in enumerate(nodes)]
    # No analysis: ngspice loads the circuit (every model bound), echoes, and stops.
    deck += [".control", "echo loaded", ".endc", ".end", ""]
    (work / "load.cir").write_text("\n".join(deck), encoding="utf-8")
    init = work / ".spiceinit"
    compat, _ = ngspice_mode(row)
    if compat:
        init.write_text(f"set ngbehavior={compat}\n", encoding="utf-8")
    elif init.exists():
        init.unlink()
    proc = run([NGSPICE, "-b", "load.cir"], cwd=work, timeout=120)
    text = (proc.stdout or "") + "\n" + (proc.stderr or "")
    errors = [ln.strip() for ln in text.splitlines() if NGSPICE_ERROR_RE.match(ln)]
    # ngspice exits 1 in batch mode whenever no analysis runs, so the verdict is its error lines and
    # the echo, which it reaches only once the circuit has loaded.
    if not errors and "loaded" not in (proc.stdout or "").split():
        errors = [f"ngspice stopped before the circuit loaded (exit {proc.returncode})"]
    return errors


def fetch_url(url: str, member: str = "") -> tuple[str, bytes | None, str]:
    """GET a URL as FETCH_AGENT: ("ok", bytes, final URL), or ("refused" | "gone" | "unreachable" |
    "error", None, why). A zip's member is read out when one is named."""
    import io
    import urllib.error
    import urllib.request
    import zipfile

    req = urllib.request.Request(url, headers={"User-Agent": FETCH_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            body, final = resp.read(), resp.geturl()
    except urllib.error.HTTPError as exc:
        kind = {401: "refused", 403: "refused", 429: "refused", 404: "gone", 410: "gone"}.get(
            exc.code, "error"
        )
        return kind, None, f"HTTP {exc.code}"
    except (urllib.error.URLError, OSError) as exc:
        return "unreachable", None, str(getattr(exc, "reason", exc))
    if member:
        try:
            with zipfile.ZipFile(io.BytesIO(body)) as zf:
                body = zf.read(member)
        except (zipfile.BadZipFile, KeyError) as exc:
            return "error", None, f"no member {member!r} in the download: {exc}"
    return "ok", body, final


def year_of(text: str) -> int | None:
    years = [int(y) for y in YEAR_RE.findall(text)]
    return max(years) if years else None


def check_source(row: SourceRow, library: Path, work: Path) -> tuple[dict, list[str], list[str]]:
    """Check one row's file against what the row says. Returns (facts, problems, warnings)."""
    facts: dict = {"kind": row.kind, "file": row.file or None, "revision": row.revision, "url": row.url}
    problems: list[str] = []
    warnings: list[str] = []
    tag = f"{row.mpn} {row.kind}"
    if not row.file:
        facts["none"] = row.note
        if row.kind == "datasheet":
            warnings.append(f"{tag}: no datasheet kept ({row.note})")
        return facts, problems, warnings
    path = (library / row.file).resolve()
    if not path.is_file():
        problems.append(f"{tag}: {row.file} is not in the library ({row.source})")
        return facts, problems, warnings
    digest = file_sha256(path)
    facts["sha256"] = digest
    if not row.sha256:
        warnings.append(f"{tag}: no SHA256 recorded for {row.file}; it is {digest}")
    elif digest != row.sha256:
        problems.append(
            f"{tag}: {row.file} changed since its row: SHA256 {digest}, the row says {row.sha256}"
        )
    if row.kind == "step":
        head = path.read_text(encoding="utf-8", errors="replace")[:4000]
        if not head.lstrip().startswith("ISO-10303-21"):
            problems.append(f"{tag}: {row.file} is not a STEP file (no ISO-10303-21 header)")
        name = re.search(r"FILE_NAME\s*\(\s*'([^']*)'\s*,\s*'([^']*)'", head)
        if name:
            facts["step_name"], facts["step_date"] = name.group(1), name.group(2)
        return facts, problems, warnings
    text = file_text(path)
    if row.revision:
        if text is None:
            warnings.append(f"{tag}: revision not checked, pdftotext is not installed")
        elif normalized(row.revision) not in normalized(text):
            problems.append(
                f"{tag}: {row.file} does not print the revision {row.revision!r}; a new revision?"
            )
    else:
        warnings.append(f"{tag}: no Revision recorded for {row.file}")
    if row.kind == "spice" and text is not None:
        sf = spice_facts(text)
        facts.update({"subckts": sorted(sf["subckts"]), "models": sf["models"], "header": sf["header"]})
        missing_inc = []
        for inc in sf["includes"]:
            if not (path.parent / inc).is_file():
                missing_inc.append(inc)
        facts["includes"] = sf["includes"]
        if missing_inc:
            problems.append(f"{tag}: sub-models not in the library: {', '.join(missing_inc)}")
        if not row.subckt:
            warnings.append(f"{tag}: no Subckt named, so ngspice's load check did not run")
        elif row.subckt.upper() not in sf["subckts"]:
            problems.append(
                f"{tag}: {row.file} defines no .SUBCKT {row.subckt} "
                f"(it defines {', '.join(sorted(sf['subckts'])) or 'none'})"
            )
        elif not missing_inc:
            if not shutil.which(NGSPICE):
                warnings.append(f"{tag}: load check skipped, {NGSPICE} is not installed")
            else:
                errs = ngspice_load_errors(
                    path, row.subckt, sf["subckts"][row.subckt.upper()], row, work / f"{row.mpn}-load"
                )
                facts["ngspice"] = "loads" if not errs else errs[:5]
                if errs:
                    problems.append(f"{tag}: {row.subckt} does not load in ngspice: {errs[0]}")
    return facts, problems, warnings


@timed
def gate_sources(
    project: Project,
    out: Path,
    parts: list[Path],
    sources: Path | None,
    fetch: bool = False,
    strict: bool = False,
) -> Result:
    """Every part on the schematic against the library's sources.csv: a datasheet for each, a SPICE
    model (or a note why none) for each U, Q and D, each kept file present, unchanged, printing the
    revision its row records, each model loading in ngspice with its sub-models, and a model older
    than its datasheet named. --fetch reads each URL again and says which differ from the library's
    copy. Writes sources/sources.md and sources.json; never writes the library."""
    if not project.sch:
        return Result("sources", "skip", "no schematic in project")
    sources = sources or find_sources(project.dir)
    if not sources:
        return Result(
            "sources", "skip", "no library/sources.csv at or above the project: name one with --sources"
        )
    if not parts:
        return Result(
            "sources", "skip", f"no parts file: name one with --parts or add {project.dir / 'parts.csv'}"
        )
    sdir = out / "sources"
    sdir.mkdir(parents=True, exist_ok=True)
    bom, stderr = schematic_bom(project, sdir / "bom.csv")
    if bom is None:
        return Result("sources", "error", "kicad-cli wrote no BOM", {"stderr": stderr})
    try:
        prows = [r for p in parts for r in read_parts(p)]
        srows = read_sources(sources)
    except (OSError, ValueError) as exc:
        return Result("sources", "error", str(exc))
    library = sources.parent

    board: dict[str, list[str]] = {}  # MPN -> refs
    no_part = []
    for b in bom:
        m = next(
            (r for r in prows if r.footprint and r.value == b["Value"] and r.footprint == b["Footprint"]),
            None,
        )
        if m is None or not m.buys or not m.mpn:
            if m is None or m.buys:
                no_part.append(f"{b['Refs']} {b['Value']}")
            continue
        board.setdefault(m.mpn, []).extend(r.strip() for r in b["Refs"].split(","))

    problems, warnings, parts_out = [], [], []
    for mpn, refs in board.items():
        rows = [r for r in srows if r.mpn == mpn]
        entry = {"mpn": mpn, "refs": refs, "rows": []}
        kinds = {r.kind for r in rows}
        if "datasheet" not in kinds:
            problems.append(f"{','.join(refs)} {mpn}: no datasheet row")
        if "spice" not in kinds and any(needs_model(r) for r in refs):
            problems.append(f"{','.join(refs)} {mpn}: no spice row (a model file, or a note why none)")
        years = {}
        for r in rows:
            facts, p, w = check_source(r, library, sdir)
            problems += p
            warnings += w
            entry["rows"].append(facts)
            if r.file and r.dated and year_of(r.dated):
                years.setdefault(r.kind, year_of(r.dated))
        if "spice" in years and "datasheet" in years and years["spice"] < years["datasheet"]:
            warnings.append(
                f"{mpn}: the model is dated {years['spice']}, the datasheet {years['datasheet']}: read the "
                "datasheet's revision history for changes the model predates"
            )
            entry["model_older"] = True
        parts_out.append(entry)

    fetched = []
    if fetch:
        fdir = sdir / "fetched"
        for r in srows:
            if r.mpn not in board or not r.url or (not r.file and r.kind != "datasheet"):
                continue
            status, body, detail = fetch_url(r.url, r.member)
            item = {"mpn": r.mpn, "kind": r.kind, "url": r.url, "status": status, "detail": detail}
            if body is not None:
                name = r.file or f"{r.mpn}-{r.kind}"
                dest = fdir / name
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_bytes(body)
                item["fetched"] = str(dest)
                kept = (library / r.file) if r.file else None
                if kept is None or not kept.is_file():
                    item["status"] = "new"
                    warnings.append(f"{r.mpn} {r.kind}: fetched, not in the library yet: {dest}")
                elif file_sha256(dest) == file_sha256(kept):
                    item["status"] = "same"
                else:
                    item["status"] = "changed"
                    warnings.append(
                        f"{r.mpn} {r.kind}: the supplier's copy differs from {r.file}: read its revision, "
                        f"then replace the file and its row ({dest})"
                    )
            else:
                warnings.append(f"{r.mpn} {r.kind}: {r.url} {status} ({detail})")
            fetched.append(item)

    details = {
        "sources": str(sources),
        "parts": parts_out,
        "no_part": no_part,
        "problems": problems,
        "warnings": warnings,
        "fetched": fetched,
    }
    (sdir / "sources.json").write_text(json.dumps(details, indent=2), encoding="utf-8")

    def cell(facts: dict) -> str:
        if facts.get("none"):
            return "none: " + facts["none"].replace("|", "/")
        bits = [f"`{facts['file']}`"]
        if facts.get("revision"):
            bits.append(facts["revision"].replace("|", "/"))
        if facts.get("ngspice") == "loads":
            bits.append("loads in ngspice")
        return ", ".join(bits)

    md = [
        f"# Sources: {project.name}",
        "",
        f"Every part on `{project.sch.name}` against `{sources}`: its datasheet, SPICE model and 3D body,"
        " each file's revision as it prints it.",
        "",
        "| Refs | MPN | Datasheet | SPICE | 3D |",
        "|---|---|---|---|---|",
    ]
    for e in parts_out:
        by = {k: [cell(f) for f in e["rows"] if f["kind"] == k] for k in SOURCE_KINDS}
        md.append(
            f"| {','.join(e['refs'])} | {e['mpn']} | "
            + " | ".join("; ".join(by[k]) or "" for k in SOURCE_KINDS)
            + " |"
        )
    md.append("")
    for title, items in (("Problems", problems), ("Warnings", warnings), ("No part named", no_part)):
        if items:
            md += [f"## {title}", "", *[f"- {i}" for i in items], ""]
    if fetched:
        md += [
            "## Fetched",
            "",
            *[f"- {f['mpn']} {f['kind']}: {f['status']} ({f['url']})" for f in fetched],
            "",
        ]
    (sdir / "sources.md").write_text("\n".join(md), encoding="utf-8")

    summary = f"{len(board)} parts, {len(problems)} problems, {len(warnings)} warnings"
    if fetch:
        changed = sum(1 for f in fetched if f["status"] == "changed")
        summary += f"; fetched {len(fetched)}, {changed} changed"
    failed = problems or (strict and warnings)
    return Result(
        "sources",
        "fail" if failed else "pass",
        summary,
        details,
        [str(sdir / "sources.md"), str(sdir / "sources.json")],
    )


def model_rows(
    deck: Path, sources: Path | None, run_dir: Path, always: bool = False
) -> tuple[list[dict], list[str], list[str], Path | None]:
    """The library models a sim deck includes, each against its sources.csv row: (models, problems,
    warnings, the deck to run). A model whose file changed since its row is a problem; one with no
    row a warning. When the deck includes a listed model, it is written again into run_dir with
    every include absolute (the model's translated copy where its row lists fixes) and a .spiceinit
    for the rows' ngspice mode; otherwise the deck to run is None and it runs as it is, unless
    `always` asks for the run folder anyway, with the deck folder's own .spiceinit when it has one."""
    text = deck.read_text(encoding="utf-8", errors="replace")
    rows = read_sources(sources) if sources else []
    library = sources.parent.resolve() if sources else None
    models, problems, warnings = [], [], []
    replace: dict[str, Path] = {}
    modes: set[str] = set()
    listed = False
    for inc in INCLUDE_RE.findall(text):
        path = (deck.parent / inc).resolve()
        item = {"file": inc, "exists": path.is_file()}
        replace[inc] = path
        if not path.is_file():
            problems.append(f"{deck.stem}: includes {inc}, which is not there")
            models.append(item)
            continue
        digest = file_sha256(path)
        item["sha256"] = digest
        # A model the project fits itself (to a datasheet's table, when its maker publishes none) lives
        # beside the decks and is the project's own file: it has no library row to check.
        if deck.parent.resolve() in path.parents:
            item["own"] = True
            models.append(item)
            continue
        row = None
        if library and library in path.parents:
            rel = path.relative_to(library).as_posix()
            row = next((r for r in rows if r.file == rel), None)
        if row is None:
            warnings.append(f"{deck.stem}: {inc} has no row in a library's sources.csv")
        else:
            listed = True
            mode, fixes = ngspice_mode(row)
            item.update({"mpn": row.mpn, "revision": row.revision, "mode": mode, "fixes": sorted(fixes)})
            if mode:
                modes.add(mode)
            if row.sha256 and row.sha256 != digest:
                problems.append(
                    f"{deck.stem}: {inc} changed since its sources row ({row.mpn}, {row.revision})"
                )
            replace[inc] = prepared_model(row, path, run_dir)
        models.append(item)
    if not listed and not always:
        return models, problems, warnings, None
    if len(modes) > 1:
        problems.append(f"{deck.stem}: its models need different ngspice modes: {', '.join(sorted(modes))}")
    run_dir.mkdir(parents=True, exist_ok=True)

    def absolute(m: re.Match) -> str:
        return m.group(0).replace(m.group(1), str(replace.get(m.group(1), m.group(1))))

    (run_dir / deck.name).write_text(INCLUDE_RE.sub(absolute, text), encoding="utf-8")
    init = run_dir / ".spiceinit"
    own_init = deck.parent / ".spiceinit"  # what ngspice reads when the deck runs in place
    if modes:
        init.write_text(f"set ngbehavior={sorted(modes)[0]}\n", encoding="utf-8")
    elif not listed and own_init.is_file():
        shutil.copyfile(own_init, init)
    elif init.exists():
        init.unlink()
    return models, problems, warnings, run_dir / deck.name


def cmd_sources(args) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    parts = [Path(p).resolve() for p in args.parts] if args.parts else []
    if not parts and (project.dir / "parts.csv").is_file():
        parts = [project.dir / "parts.csv"]
    sources = Path(args.sources).resolve() if args.sources else None
    return emit([gate_sources(project, out, parts, sources, args.fetch, args.strict)], args, None)


# ------------------------------------------------------------------ fetch
#
# One file for a library, a part's datasheet, model or body, fetched once under the workcenter's own
# name, and the sources.csv row that records it (PROCESSES.md P27). For a part before any board names it.

SOURCES_HEADER = ("MPN", "Kind", "URL", "File", "Member", "Revision", "Dated", "Subckt", "Ngspice", "SHA256")
SOURCES_HEADER += ("Checked", "Note")
KIND_BY_SUFFIX = {".pdf": "datasheet", ".step": "step", ".stp": "step"}
KIND_BY_SUFFIX |= {s: "spice" for s in (".lib", ".mod", ".cir", ".sub", ".spi", ".sp", ".ckt", ".subckt")}
# Lines of a datasheet's text that may carry its revision and date, shown to the reader filling the row.
REVISION_RE = re.compile(r"\b(rev(ision)?\b|rev\.|version\b|v\.\d|\d{4}-\d{2}\b|©|copyright\b)", re.I)


def library_csv(start: Path) -> Path | None:
    """The nearest sources.csv in `start` or a folder above it, up to the repository's root."""
    for d in (start, *start.parents):
        if (d / "sources.csv").is_file():
            return d / "sources.csv"
        if (d / ".git").exists():
            break
    return None


def revision_lines(path: Path) -> list[str]:
    text = file_text(path) or ""
    if path.suffix.lower() in KIND_BY_SUFFIX and KIND_BY_SUFFIX[path.suffix.lower()] == "spice":
        return spice_facts(text)["header"]
    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
    seen, found = set(), []
    for ln in lines[:60] + lines[-40:]:
        if REVISION_RE.search(ln) and ln not in seen and len(ln) < 160:
            seen.add(ln)
            found.append(ln)
    return found[:8]


def cmd_fetch(args) -> int:
    """GET one URL once as FETCH_AGENT into --to, and print (with --row append) its sources.csv row."""
    dest = Path(args.to).resolve()
    sources = Path(args.sources).resolve() if args.sources else library_csv(dest.parent)
    kind = (args.kind or KIND_BY_SUFFIX.get(dest.suffix.lower(), "")).lower()
    report: dict = {"url": args.url, "file": str(dest), "kind": kind, "mpn": args.mpn or ""}

    def fail(why: str) -> int:
        report["error"] = why
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print(f"fetch: {why}", file=sys.stderr)
        return EXIT_FAIL

    if kind and kind not in SOURCE_KINDS:
        return fail(f"--kind {kind!r} is not one of {', '.join(SOURCE_KINDS)}")
    library = sources.parent if sources else dest.parent.parent
    if not dest.is_relative_to(library):
        return fail(f"{dest} is not under the library {library} that {sources} describes")
    rel = dest.relative_to(library).as_posix()
    # Read as bytes: text mode would turn a CRLF file's line ends into LF, and the append would too.
    rows_text = sources.read_bytes().decode("utf-8") if sources and sources.is_file() else ""
    if args.row:
        if not sources:
            return fail(f"no sources.csv in {dest.parent} or above: name one with --sources")
        if not args.mpn or not kind:
            return fail("--row needs --mpn and a --kind (or a file suffix that names one)")
        for n, row in enumerate(csv.DictReader(io.StringIO(rows_text)), start=2):
            if row.get("MPN") == args.mpn and (row.get("Kind") or "").lower() == kind:
                return fail(f"{sources.name}:{n} already has a {kind} row for {args.mpn}; nothing fetched")

    status, body, detail = fetch_url(args.url, args.member or "")
    report.update({"status": status, "detail": detail})
    if body is None:
        return fail(
            f"{args.url} {status} ({detail}); nothing written. A refusal is the site's answer: download the "
            "file by hand, or keep a row with no File and a Note that says where it is"
        )
    digest = hashlib.sha256(body).hexdigest()
    report.update({"bytes": len(body), "sha256": digest})
    if detail != args.url:
        report["final_url"] = detail
    if dest.exists():
        if file_sha256(dest) != digest:
            return fail(
                f"{dest} exists and differs from the download: move it away first, or name another --to"
            )
        report["state"] = "unchanged"
    else:
        dest.parent.mkdir(parents=True, exist_ok=True)
        part = dest.with_name(dest.name + ".part")
        part.write_bytes(body)
        part.replace(dest)
        report["state"] = "written"

    subckt = ""
    if kind == "spice":
        subckts = list(spice_facts(dest.read_text(encoding="utf-8", errors="replace"))["subckts"])
        subckt = subckts[0] if len(subckts) == 1 else ""
    values = {
        "MPN": args.mpn or "",
        "Kind": kind,
        "URL": args.url,
        "File": rel,
        "Member": args.member or "",
        "Subckt": subckt,
        "SHA256": digest,
        "Checked": datetime.date.today().isoformat(),
    }
    header = SOURCES_HEADER
    if rows_text:
        header = tuple(next(csv.reader(io.StringIO(rows_text)), SOURCES_HEADER))
    newline = "\r\n" if "\r\n" in rows_text else "\n"
    line = io.StringIO()
    csv.writer(line, lineterminator=newline).writerow([values.get(c, "") for c in header])
    report["row"] = {c: values.get(c, "") for c in header}
    report["revision_lines"] = revision_lines(dest)

    if args.row:
        # The row goes in as text after the file's own bytes (P9 step 9), through a new file that
        # replaces the old one only once it reads back as a library (step 3).
        text = rows_text or ",".join(header) + newline  # --sources may name a library not yet started
        if not text.endswith(("\n", "\r")):
            text += newline
        part = sources.with_name(sources.name + ".part")
        sources.parent.mkdir(parents=True, exist_ok=True)
        part.write_text(text + line.getvalue(), encoding="utf-8", newline="")
        try:
            read_sources(part)
        except ValueError as exc:
            part.unlink()
            return fail(f"the row would not read back: {exc}")
        part.replace(sources)
        report["appended"] = str(sources)

    if args.json:
        print(json.dumps(report, indent=2))
        return EXIT_PASS
    where = f"wrote {dest}" if report["state"] == "written" else f"{dest} already holds it"
    print(f"fetch: {args.url} ok, {len(body)} bytes, SHA256 {digest}; {where}")
    if report.get("final_url"):
        print(f"  served from {report['final_url']}")
    for ln in report["revision_lines"]:
        print(f"  revision? {ln}")
    print("row (Revision and Dated as the file prints them, filled by the reader):")
    print(",".join(header))
    print(line.getvalue().rstrip("\r\n"))
    if report.get("appended"):
        print(f"appended to {sources}")
    return EXIT_PASS


# ------------------------------------------------------------------ curve
#
# A datasheet's curve read from the PDF's own vectors (a fuse's time-current curve, a MOSFET's safe
# operating area, a derating line), not from a picture. tools/pdfcurve.py lists the page's paths with
# pdfminer under the venv; the frame, the axes, an outline's middle and the interpolation are here.

AXIS_SCALES = ("log", "lin")
FRAME_TOLERANCE = 2.0  # points: a curve's ends sit on the frame's lines, which have a width


def curve_axis(text: str) -> tuple[str, float, float]:
    """`log:MIN:MAX` or `lin:MIN:MAX`: the value at the frame's left (bottom) edge and at its right (top)."""
    scale, _, rest = text.partition(":")
    lo, _, hi = rest.partition(":")
    try:
        a, b = float(lo), float(hi)
    except ValueError:
        raise argparse.ArgumentTypeError(f"an axis is log:MIN:MAX or lin:MIN:MAX, not {text!r}") from None
    if scale not in AXIS_SCALES or a == b or (scale == "log" and (a <= 0 or b <= 0)):
        raise argparse.ArgumentTypeError(
            f"an axis is log:MIN:MAX or lin:MIN:MAX, MIN and MAX apart, not {text!r}"
        )
    return scale, a, b


def number_list(text: str) -> list[float]:
    try:
        return [float(v) for v in text.split(",") if v.strip()]
    except ValueError:
        raise argparse.ArgumentTypeError(f"numbers separated by commas, not {text!r}") from None


def curve_frame(text: str) -> tuple[float, float, float, float]:
    vals = number_list(text)
    if len(vals) != 4 or vals[0] == vals[2] or vals[1] == vals[3]:
        raise argparse.ArgumentTypeError(f"a frame is x0,y0,x1,y1 in PDF points, not {text!r}")
    return vals[0], vals[1], vals[2], vals[3]


def axis_value(p: float, p0: float, p1: float, axis: tuple[str, float, float]) -> float:
    """A page coordinate on the axis from p0 (the axis's MIN) to p1 (its MAX), as the axis's value."""
    scale, lo, hi = axis
    f = (p - p0) / (p1 - p0)
    if scale == "log":
        return 10 ** (math.log10(lo) + f * (math.log10(hi) - math.log10(lo)))
    return lo + f * (hi - lo)


def axis_unit(v: float, axis: tuple[str, float, float]) -> float:
    """A value where the axis is linear: its log for a log axis."""
    return math.log10(v) if axis[0] == "log" else v


def stations(chain: list[tuple[float, float]]) -> list[float]:
    """Each point's distance along a polyline, as a fraction of its length."""
    run = [0.0]
    for a, b in itertools.pairwise(chain):
        run.append(run[-1] + math.dist(a, b))
    return [s / (run[-1] or 1.0) for s in run]


def point_at(chain: list[tuple[float, float]], st: list[float], s: float) -> tuple[float, float]:
    """The point a fraction s along a polyline whose stations are st."""
    k = min(max(bisect.bisect_right(st, s) - 1, 0), len(chain) - 2)
    span = st[k + 1] - st[k]
    t = 0.0 if span == 0 else (s - st[k]) / span
    a, b = chain[k], chain[k + 1]
    return a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])


def outline_middle(pts: list[tuple[float, float]]) -> list[tuple[float, float]]:
    """A line drawn as a filled outline, out along one edge and back along the other, reduced to its middle.
    The stroke's two ends are the outline's farthest pair of points, which split the outline into two
    chains from end to end. Points the same fraction along each chain are paired, at every point of
    either chain, and each pair's midpoint is a point of the middle. Where both edges run straight their
    every pair's midpoint lies on the middle; within a stroke's width of a cap the pairs cross the cap
    and the middle is off by up to half the width. A line that doubles back on itself has other far
    pairs: select it out of the outline by hand."""
    p = list(pts)
    if len(p) > 2 and p[0] == p[-1]:
        p = p[:-1]
    n = len(p)
    i, j, far = 0, 0, -1.0
    for a in range(n):
        for b in range(a + 1, n):
            d = (p[a][0] - p[b][0]) ** 2 + (p[a][1] - p[b][1]) ** 2
            if d > far:
                i, j, far = a, b, d
    one = p[i : j + 1]
    other = (p[j:] + p[: i + 1])[::-1]
    st_one, st_other = stations(one), stations(other)
    middle: list[tuple[float, float]] = []
    for s in sorted(set(st_one) | set(st_other)):
        a, b = point_at(one, st_one, s), point_at(other, st_other, s)
        m = ((a[0] + b[0]) / 2, (a[1] + b[1]) / 2)
        if not middle or m != middle[-1]:
            middle.append(m)
    return middle


def crossings(
    points: list[tuple[float, float]], at: float, along: int, axes: tuple[tuple, tuple]
) -> list[float]:
    """Where a curve passes a value on one axis (`along` 0 for x, 1 for y): the other axis's values,
    interpolated where both axes are linear (in decades on a log axis). Crossings closer than 0.2 % of
    the axis apart are one."""
    found: list[float] = []
    other = 1 - along
    v = axis_unit(at, axes[along])
    for a, b in itertools.pairwise(points):
        ua, ub = axis_unit(a[along], axes[along]), axis_unit(b[along], axes[along])
        if ua == ub or not min(ua, ub) <= v <= max(ua, ub):
            continue
        t = (v - ua) / (ub - ua)
        wa, wb = axis_unit(a[other], axes[other]), axis_unit(b[other], axes[other])
        w = wa + t * (wb - wa)
        found.append(10**w if axes[other][0] == "log" else w)
    span = abs(axis_unit(axes[other][2], axes[other]) - axis_unit(axes[other][1], axes[other]))
    merged: list[float] = []
    for y in found:
        if merged and abs(axis_unit(y, axes[other]) - axis_unit(merged[-1], axes[other])) < 0.002 * span:
            continue
        merged.append(y)
    return merged


def curve_groups(paths: list[dict]) -> list[dict]:
    """The page's paths grouped by how they are drawn: kind, stroke width, stroke and fill, colours."""
    groups: dict[tuple, dict] = {}
    for p in paths:
        key = (p["kind"], p["width"], p["stroke"], p["fill"], p["color"], p["fill_color"])
        g = groups.setdefault(
            key, {"kind": p["kind"], "width": p["width"], "stroke": p["stroke"], "fill": p["fill"]}
        )
        g.setdefault("color", p["color"] if p["stroke"] else p["fill_color"])
        g.setdefault("ids", []).append(p["id"])
        xs = [x for x, _ in p["pts"]]
        ys = [y for _, y in p["pts"]]
        box = g.setdefault("bbox", [min(xs), min(ys), max(xs), max(ys)])
        g["bbox"] = [min(box[0], *xs), min(box[1], *ys), max(box[2], *xs), max(box[3], *ys)]
        g["points"] = g.get("points", 0) + len(p["pts"])
    return sorted(groups.values(), key=lambda g: (-g["width"], g["kind"], -len(g["ids"])))


def inside(p: dict, frame: tuple[float, float, float, float]) -> bool:
    x0, x1 = sorted((frame[0], frame[2]))
    y0, y1 = sorted((frame[1], frame[3]))
    return all(
        x0 - FRAME_TOLERANCE <= x <= x1 + FRAME_TOLERANCE
        and y0 - FRAME_TOLERANCE <= y <= y1 + FRAME_TOLERANCE
        for x, y in p["pts"]
    )


def cmd_curve(args) -> int:
    """List a PDF page's paths, or map the curves inside a frame onto the plot's axes."""
    pdf = Path(args.pdf).resolve()
    if not pdf.is_file():
        raise SystemExit(f"curve: {pdf} not found")
    mapping = (args.frame, args.x, args.y)
    if any(mapping) and not all(mapping):
        raise SystemExit("curve: --frame, --x and --y go together")
    if (args.at or args.at_y or args.paths) and not all(mapping):
        raise SystemExit("curve: --at, --at-y and --paths need --frame, --x and --y")
    script = SRC_DIR / "tools" / "pdfcurve.py"
    # No -s: the venv reads the packages pip installed and reports, wherever pip found them satisfied.
    proc = subprocess.run(
        [venv_python(), str(script), str(pdf), str(args.page)],
        capture_output=True,
        text=True,
        timeout=300,
    )
    if "No module named 'pdfminer'" in proc.stderr:
        print(f"curve: pdfminer.six is not in {venv_python()}; install.sh puts it there", file=sys.stderr)
        return EXIT_SKIP
    if proc.returncode != 0:
        print(proc.stderr.strip() or f"curve: pdfcurve exited {proc.returncode}", file=sys.stderr)
        return EXIT_FAIL
    page = json.loads(proc.stdout)
    paths = page["paths"]
    labels = []
    for t in page["texts"]:
        if QUANTITY_RE.match(t["text"]) or re.fullmatch(r"[-+]?\d+(\.\d+)?[eE][-+]?\d+", t["text"]):
            labels.append(
                {
                    "text": t["text"],
                    "at": [
                        round((t["bbox"][0] + t["bbox"][2]) / 2, 1),
                        round((t["bbox"][1] + t["bbox"][3]) / 2, 1),
                    ],
                }
            )
    if not all(mapping):
        groups = curve_groups(paths)
        frames = [p for p in paths if p["kind"] == "rect" and p["stroke"]]
        frames.sort(key=lambda p: -abs((p["pts"][2][0] - p["pts"][0][0]) * (p["pts"][2][1] - p["pts"][0][1])))
        listing = {
            "pdf": str(pdf),
            "page": args.page,
            "size": [page["width"], page["height"]],
            "groups": groups,
            "frames": [
                [
                    min(x for x, _ in p["pts"]),
                    min(y for _, y in p["pts"]),
                    max(x for x, _ in p["pts"]),
                    max(y for _, y in p["pts"]),
                ]
                for p in frames[:4]
            ],
            "labels": labels,
        }
        if args.json:
            print(json.dumps(listing, indent=2))
            return EXIT_PASS
        size = f"{page['width']:g} x {page['height']:g} pt"
        print(f"curve: {pdf.name} page {args.page}, {size}, {len(paths)} paths")
        by_id = {p["id"]: p for p in paths}
        for n, g in enumerate(groups, 1):
            how = (
                ", ".join(w for w, on in (("stroked", g["stroke"]), ("filled", g["fill"])) if on)
                or "unpainted"
            )
            b = g["bbox"]
            kind = g["kind"] + ("s" if len(g["ids"]) > 1 else "")
            print(
                f"group {n}: {len(g['ids'])} {kind}, width {g['width']:g}, {how} {g['color']}, "
                f"x {b[0]:.1f}-{b[2]:.1f} y {b[1]:.1f}-{b[3]:.1f}"
            )
            if g["kind"] == "path" or len(g["ids"]) <= 6:
                for i in g["ids"]:
                    p = by_id[i]
                    xs = [x for x, _ in p["pts"]]
                    ys = [y for _, y in p["pts"]]
                    shape = (
                        "outline"
                        if p["fill"] and len(p["pts"]) >= 6
                        else ("closed" if p["closed"] else "open")
                    )
                    print(
                        f"   #{i:<5} {len(p['pts']):>4} points  x {min(xs):.2f}-{max(xs):.2f}  "
                        f"y {min(ys):.2f}-{max(ys):.2f}  {shape}"
                    )
        for f in listing["frames"]:
            print(f"frame? --frame {f[0]:.2f},{f[1]:.2f},{f[2]:.2f},{f[3]:.2f}  (a stroked rectangle)")
        for lab in labels:
            print(f"label {lab['text']!r} at x {lab['at'][0]} y {lab['at'][1]}")
        return EXIT_PASS

    frame, axes = args.frame, (args.x, args.y)
    if args.paths:
        wanted = {int(v) for v in args.paths}
        chosen = [p for p in paths if p["id"] in wanted]
        missing = sorted(wanted - {p["id"] for p in chosen})
        if missing:
            raise SystemExit(f"curve: no path {', '.join(f'#{m}' for m in missing)} on page {args.page}")
    else:
        chosen = [p for p in paths if p["kind"] == "path" and len(p["pts"]) >= 4 and inside(p, frame)]
    chosen.sort(key=lambda p: min(x for x, _ in p["pts"]))
    curves = []
    for n, p in enumerate(chosen, 1):
        pts = [tuple(xy) for xy in p["pts"]]
        outline = p["fill"] and len(pts) >= 6
        line = outline_middle(pts) if outline else pts
        data = [
            (axis_value(x, frame[0], frame[2], axes[0]), axis_value(y, frame[1], frame[3], axes[1]))
            for x, y in line
        ]
        entry = {"curve": n, "path": p["id"], "points": len(pts), "outline": outline, "data": data}
        entry["at"] = [{"x": x, "y": crossings(data, x, 0, axes)} for x in args.at or []]
        entry["at_y"] = [{"y": y, "x": crossings(data, y, 1, axes)} for y in args.at_y or []]
        curves.append(entry)
    if args.json:
        print(json.dumps({"pdf": str(pdf), "page": args.page, "frame": frame, "curves": curves}, indent=2))
        return EXIT_PASS if curves else EXIT_FAIL
    if not curves:
        print(f"curve: no path of 4 points or more inside the frame on page {args.page}", file=sys.stderr)
        return EXIT_FAIL
    for c in curves:
        xs = [x for x, _ in c["data"]]
        ys = [y for _, y in c["data"]]
        kind = f"an outline, its middle {len(c['data'])} points" if c["outline"] else "a line"
        print(
            f"curve {c['curve']} (#{c['path']}): {c['points']} points, {kind}; "
            f"x {min(xs):.4g} to {max(xs):.4g}, y {min(ys):.4g} to {max(ys):.4g}"
        )
        for a in c["at"]:
            print(f"  at x={a['x']:g}: y=" + (" / ".join(f"{v:.4g}" for v in a["y"]) or "outside the curve"))
        for a in c["at_y"]:
            print(f"  at y={a['y']:g}: x=" + (" / ".join(f"{v:.4g}" for v in a["x"]) or "outside the curve"))
        if not c["at"] and not c["at_y"]:
            for x, y in c["data"]:
                print(f"  {x:.5g} {y:.5g}")
    return EXIT_PASS



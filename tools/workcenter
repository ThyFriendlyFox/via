def point(value: str) -> tuple[float, float]:
    """x,y in mm."""
    try:
        x, y = (float(v) for v in value.split(","))
    except ValueError:
        raise argparse.ArgumentTypeError(f"a point is x,y in mm, not {value!r}") from None
    return (x, y)


def track_points(value: str) -> list[tuple[float, float]]:
    pts = [point(p) for p in value.split()]
    if len(pts) < 2:
        raise argparse.ArgumentTypeError(f'a track is 2 points or more, "x,y x,y ...", not {value!r}')
    return pts


def pad_nets(value: str) -> dict[str, str]:
    nets = dict(item.split("=", 1) for item in value.split(",") if "=" in item)
    if not nets or any(not k or not v for k, v in nets.items()):
        raise argparse.ArgumentTypeError(f"pad nets are PAD=NET,PAD=NET, not {value!r}")
    return nets


def board_file(path: str) -> str:
    project = find_project(path)
    if project.pcb is None:
        raise SystemExit(f"inspect: {project.dir} has no .kicad_pcb")
    return str(project.pcb)


def cmd_inspect(args) -> int:
    """Read a board with KiCad's own geometry: tools/inspect_board.py under the venv's Python, which
    sees pcbnew and Pillow; it writes only map's images, into --out."""
    spec: dict = {"what": args.view, "board": board_file(args.board), "json": args.json or args.inspect_json}
    if getattr(args, "box", None):
        x0, x1, y0, y1 = args.box
        if not (x0 < x1 and y0 < y1):
            raise SystemExit("inspect: --box is X0 X1 Y0 Y1 with X0 < X1 and Y0 < Y1")
        spec["box"] = args.box
    if args.view == "map":
        spec["layers"] = [ly for arg in args.layers or [] for ly in arg.split(",") if ly]
        spec["scale"] = args.scale
        spec["out"] = str(
            Path(args.out).resolve() if args.out else Path(spec["board"]).parent / "build" / "inspect"
        )
    elif args.view == "list":
        spec.update(layer=args.layer, net=args.net)
    elif args.view == "probe":
        if sum(x is not None for x in (args.via, args.track, args.part)) != 1:
            raise SystemExit("inspect probe: give one of --via X,Y, --track 'X,Y X,Y ...' or --part REF")
        if (args.via or args.track) and not args.net:
            raise SystemExit("inspect probe: --via and --track need --net")
        if args.track and not args.layer:
            raise SystemExit("inspect probe: --track needs --layer")
        if args.part and args.at is None:
            raise SystemExit("inspect probe: --part needs --at X,Y")
        spec.update(
            via=args.via,
            track=args.track,
            part=args.part,
            at=args.at,
            rot=args.rot,
            footprint=args.footprint,
            nets=args.nets,
            back=args.back,
            net=args.net,
            layer=args.layer,
            size=args.size,
            drill=args.drill,
            width=args.width,
        )
    elif args.view == "net":
        spec["net"] = args.net
    elif args.view == "islands":
        spec["net"] = args.net
    elif args.view == "resistance":
        spec.update(net=args.net, temp=args.temp, plating=args.plating)
        spec["from"], spec["to"] = getattr(args, "from"), args.to
    elif args.view == "crossed":
        spec["new"] = board_file(args.new) if args.new else None
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    proc = subprocess.run(
        [venv_python(), "-s", str(INSPECT_SCRIPT), json.dumps(spec)], capture_output=True, text=True, env=env
    )
    sys.stdout.write(proc.stdout)
    sys.stderr.write("".join(ln for ln in proc.stderr.splitlines(True) if not KICAD_NOISE.search(ln)))
    return proc.returncode if proc.returncode in (EXIT_PASS, EXIT_FAIL, EXIT_SKIP) else EXIT_FAIL


USER_SETTINGS = Path.home() / ".claude" / "settings.json"


def no_cd_hook_installed(settings: Path = USER_SETTINGS) -> bool:
    """True when the user-wide Claude Code settings run the no-cd hook (install.sh puts it there, M35)."""
    try:
        data = json.loads(settings.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    entries = data.get("hooks", {}).get("PreToolUse", []) if isinstance(data, dict) else []
    return any("no_cd.py" in h.get("command", "") for e in entries for h in e.get("hooks", []))


def cmd_doctor(args) -> int:
    kicad = tool_version([KICAD_CLI, "version"])
    ngspice = tool_version([NGSPICE, "--version"], r"(?<=ngspice-)\d+")
    java = tool_version([JAVA, "-version"], r'(?<=version ")\d+(\.\d+)*')
    py = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    checks = {
        "kicad-cli": {"required": True, "ok": bool(kicad and kicad.startswith("10.")), "version": kicad},
        "ngspice": {"required": True, "ok": bool(ngspice), "version": ngspice},
        "python": {"required": True, "ok": sys.version_info >= (3, 12), "version": py},
        "java": {"required": False, "ok": bool(java and int(java.split(".")[0]) >= 21), "version": java},
        "freerouting": {"required": False, "ok": FREEROUTING_JAR.is_file(), "path": str(FREEROUTING_JAR)},
        "venv": {
            "required": False,
            "ok": (WC_ROOT / "venv" / "bin" / "python").exists(),
            "path": str(WC_ROOT / "venv"),
        },
        "xvfb": {"required": False, "ok": shutil.which("Xvfb") is not None},
        "rsvg-convert": {"required": False, "ok": shutil.which("rsvg-convert") is not None},
        "ffmpeg": {"required": False, "ok": shutil.which("ffmpeg") is not None},
        "symbols": {
            "required": False,
            "ok": Path("/usr/share/kicad/symbols/Device.kicad_sym").is_file(),
            "path": "/usr/share/kicad/symbols",
        },
        "manifest": {
            "required": True,
            "ok": (SRC_DIR / "WORKCENTER.md").is_file(),
            "path": str(SRC_DIR / "WORKCENTER.md"),
        },
        "no-cd hook": {"required": False, "ok": no_cd_hook_installed(), "path": str(USER_SETTINGS)},
        "kistack": {
            "required": False,
            "ok": (KISTACK_DIR / "skills" / "layout-placement" / "scripts").is_dir(),
            "path": str(KISTACK_DIR),
        },
    }
    missing_required = [k for k, v in checks.items() if v["required"] and not v["ok"]]
    degraded = [k for k, v in checks.items() if not v["required"] and not v["ok"]]
    status = "fail" if missing_required else ("degraded" if degraded else "ok")
    payload = {
        "status": status,
        "root": str(WC_ROOT),
        "src": str(SRC_DIR),
        "checks": checks,
        "missing_required": missing_required,
        "degraded": degraded,
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"workcenter ee: {status}  (root {WC_ROOT}, src {SRC_DIR})")
        for name, c in checks.items():
            mark = "ok " if c["ok"] else ("MISSING" if c["required"] else "absent ")
            extra = c.get("version") or c.get("path") or ""
            print(f"  {mark:8} {name:12} {extra}")
    return EXIT_FAIL if missing_required else EXIT_PASS


def emit(results: list[Result], args, out: Path | None = None) -> int:
    statuses = {r.status for r in results}
    if statuses & {"fail", "error"}:
        worst = EXIT_FAIL
    elif "skip" in statuses and "pass" not in statuses:
        worst = EXIT_SKIP
    else:
        worst = EXIT_PASS
    if out is not None:
        (out / "gates.json").write_text(json.dumps([asdict(r) for r in results], indent=2), encoding="utf-8")
    if args.json:
        print(json.dumps([asdict(r) for r in results], indent=2))
    else:
        for r in results:
            print(f"{r.status.upper():6} {r.gate:10} {r.summary}  [{r.seconds}s]")
            for v in r.details.get("first", [])[:5]:
                print(f"       - {v.get('severity')}: {v.get('type')}: {v.get('description')}")
            for f in r.details.get("failures", [])[:5]:
                print(f"       - {f}")
    return worst


def cmd_gate(args, fn, **kwargs) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    # A single gate writes its own report into `out`; only `gates` writes the combined gates.json.
    return emit([fn(project, out, **kwargs)], args, None)


def cmd_gates(args) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    results: list[Result] = []
    for gate in GATE_ORDER:
        fn = {"erc": gate_erc, "drc": gate_drc, "sim": gate_sim, "export": gate_export}[gate]
        kwargs = {"strict": args.strict}
        if gate == "export":
            kwargs["step"] = args.step
        if gate == "drc":
            kwargs["fab"] = args.fab
        result = fn(project, out, **kwargs)
        results.append(result)
        if result.status in ("fail", "error"):
            break
    code = emit(results, args, out)
    if not args.json:
        verdict = "GREEN" if code == EXIT_PASS else ("SKIPPED" if code == EXIT_SKIP else "RED")
        print(f"{verdict}: {project.name}  report {out / 'gates.json'}")
    if args.report:
        # The one file a gate run writes outside `out`: named by the user, only between its markers.
        blocks = doctools().gates_report(Path(args.report).resolve(), project, results, sys.modules[__name__])
        if not args.json:
            print(f"wrote {', '.join(blocks)} into {args.report}")
    return code


def doctools():
    """tools/doctools.py: docs, costs, pictures, version, diagram and the gates report."""
    sys.path.insert(0, str(SRC_DIR / "tools"))
    import doctools as module

    return module


def render_views(value: str) -> tuple[str, ...]:
    names = RENDER_VIEWS if value == "all" else tuple(v.strip() for v in value.split(",") if v.strip())
    unknown = [v for v in names if v not in RENDER_VIEWS]
    if unknown or not names:
        raise argparse.ArgumentTypeError(f"views are {', '.join(RENDER_VIEWS)} or all, not {value!r}")
    return names



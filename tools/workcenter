    q.add_argument("--to", required=True, metavar="REF.PAD", help="the other end, e.g. U2.1")
    q.add_argument("--temp", type=float, default=20.0, help="copper temperature, °C (default 20)")
    q.add_argument("--plating", type=float, help="via barrel plating, mm (default: the board's setting)")
    q = add_view(
        "crossed",
        "the nets whose tracks or vias crossed a window; with --new, which it leaves open",
        box=True,
    )
    q.add_argument(
        "--new", metavar="BOARD", help="the new board: says which of those nets it no longer connects"
    )

    doctools().register(sub, sys.modules[__name__])

    args = parser.parse_args(argv)
    if getattr(args, "run", None):
        return args.run(args)
    if args.command == "doctor":
        return cmd_doctor(args)
    if args.command == "placement":
        return cmd_placement(args)
    if args.command == "inspect":
        return cmd_inspect(args)
    if args.command == "design":
        if args.seed and not args.route:
            parser.error("design --seed needs --route")
        if args.seed and not Path(args.seed).is_file():
            parser.error(f"design --seed: no board file {args.seed}")
        return check_design(args) if args.check else cmd_design(args)
    if args.command == "render":
        return cmd_gate(
            args,
            gate_render,
            width=args.width,
            views=args.views,
            spin_frames=args.spin_frames,
            spin_tilt=args.spin_tilt,
            spin_zoom=args.spin_zoom,
            spin_pivot=args.spin_pivot,
            strict=args.strict,
        )
    if args.command == "gates":
        return cmd_gates(args)
    if args.command == "procure":
        return cmd_procure(args)
    if args.command == "sources":
        return cmd_sources(args)
    if args.command == "verify":
        return cmd_verify(args)
    if args.command == "sim":
        return cmd_sim(args)
    if args.command == "fetch":
        return cmd_fetch(args)
    if args.command == "curve":
        return cmd_curve(args)
    if args.command == "ci":
        return cmd_ci(args)
    if args.command == "mutate":
        return cmd_mutate(args)
    if args.command == "autoroute":
        return cmd_gate(
            args, gate_autoroute, dsn=args.dsn, passes=args.passes, threads=args.threads, timeout=args.timeout
        )
    fn = {"erc": gate_erc, "drc": gate_drc, "sim": gate_sim, "export": gate_export}[args.command]
    kwargs = {"strict": args.strict}
    if args.command == "export":
        kwargs["step"] = args.step
    if args.command == "drc":
        kwargs["fab"] = args.fab
    return cmd_gate(args, fn, **kwargs)


if __name__ == "__main__":
    sys.exit(main())

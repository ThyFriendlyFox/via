def cmd_design(args) -> int:
    """Build a kicadgen design file into a KiCad project, routing it when asked."""
    sys.path.insert(0, str(SRC_DIR / "tools"))
    import kicadgen

    design_path = Path(args.design).resolve()
    out_dir = Path(args.out).resolve() if args.out else design_path.parent
    t0 = time.monotonic()
    design = kicadgen.load_design(design_path)
    summary: dict = {
        "design": str(design_path),
        "name": design.name,
        "parts": len(design.parts),
        "nets": len(design.net_names()),
    }
    code = EXIT_PASS
    # Vias are checked before anything is written or routed: every via size against the board's own
    # rules, since the router places most vias and the DRC of an unrouted board sees none (M46); and
    # each hand via's place, since a via passes every layer, and one in a keepout or on another face's
    # pad is a short the DRC would only find later (M40, M41).
    summary["via_problems"] = design.check_via_rules() + design.check_vias()
    # A part inside an area the design keeps parts out of (a strip, a spacer, a body over the board, M87).
    summary["part_problems"] = design.check_parts()
    if summary["part_problems"]:
        code = EXIT_FAIL
    # Control inputs that can float (a gate, an enable, a switch, an I2C line with nothing holding it):
    # listed for every design, and a failure for one that sets check_pulls.
    summary["pulls"] = design.undefined_inputs()
    if summary["pulls"] and design.check_pulls:
        code = EXIT_FAIL
    if summary["via_problems"]:
        code = EXIT_FAIL
    # A previous board's routed copper, read before anything is written: --out may be the folder that
    # holds it.
    copper = kicadgen.board_copper(Path(args.seed).resolve()) if args.seed else None
    if args.route:
        fixed_segments, fixed_vias = list(design.segments), list(design.vias)  # hand-routed copper
        try:
            for round_no in range(1, args.rounds + 1):
                # Each round sifts the seed again: a reserved via can stand on a seed track.
                seed = design.seed_wiring(copper) if copper else None
                summary["route"] = kicadgen.route(
                    design, out_dir / "build" / "route", passes=args.passes, timeout=args.timeout, seed=seed
                )
                if seed:
                    summary["seed"] = {
                        "board": str(Path(args.seed).resolve()),
                        "tracks": seed["given"][0],
                        "vias": seed["given"][1],
                        "seeded": [len(seed["segments"]), len(seed["vias"])],
                        "loose": [len(seed["loose"][0]), len(seed["loose"][1])],
                        "left": seed["left"],
                        "kept": design.seed_kept(seed),
                    }
                summary["files"] = [str(p) for p in design.write(out_dir)]
                summary["rounds"] = round_no
                if not design.islands or round_no == args.rounds:
                    break
                # Pads walled off from their pour: reserve a via beside each, then route again around it.
                design.segments = list(fixed_segments)
                design.vias = list(fixed_vias)
                if not design.reserve_vias([pad for island in design.islands for pad in island]):
                    break
                fixed_vias = list(design.vias)
            if summary["route"].get("unrouted"):
                code = EXIT_FAIL
        except FileNotFoundError as exc:
            summary["route"] = {"skip": f"engine missing: {exc}"}
            code = EXIT_SKIP
    if "files" not in summary:
        summary["files"] = [str(p) for p in design.write(out_dir)]
    summary["islands"] = design.islands
    summary["stitches"] = [{**s, "at": list(s["at"])} for s in design.stitches]
    summary["seconds"] = round(time.monotonic() - t0, 2)
    # The verdict is the exit code even though every file is written (M85): say so on the last line.
    red = []
    if summary["via_problems"]:
        red.append(f"{len(summary['via_problems'])} via problem(s)")
    if summary["part_problems"]:
        red.append(f"{len(summary['part_problems'])} part(s) in a parts keep-out")
    if summary["pulls"] and design.check_pulls:
        red.append(f"{len(summary['pulls'])} floating input(s)")
    if summary.get("route", {}).get("unrouted"):
        red.append(f"{summary['route']['unrouted']} unrouted")
    if code == EXIT_FAIL:
        summary["red"] = red
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(
            f"design {design.name}: {summary['parts']} parts, {summary['nets']} nets  [{summary['seconds']}s]"
        )
        r = summary.get("route")
        if r and "skip" in r:
            print(f"  route skipped: {r['skip']}")
        elif r:
            unrouted = "DRC decides" if r["unrouted"] is None else f"{r['unrouted']} unrouted"
            rounds = f"{summary.get('rounds', 1)} round(s)"
            print(f"  routed: {r['segments']} segments, {r['vias']} vias, {unrouted}, {rounds}  ({r['log']})")
        s = summary.get("seed")
        if s:
            left = ", ".join(f"{n} {why}" for why, n in sorted(s["left"].items(), key=lambda kv: -kv[1]))
            print(
                f"  seed: {s['tracks']} tracks, {s['vias']} vias in {s['board']}; to the router "
                f"{s['seeded'][0]} tracks, {s['seeded'][1]} vias "
                f"({s['loose'][0]} tracks, {s['loose'][1]} vias loose); left out {left or 'none'}; "
                f"the new route kept {s['kept']} of the {s['seeded'][0]} tracks"
            )
        for line in summary["pulls"]:
            print(f"  pull: {line}")
        for problem in summary["via_problems"]:
            print(f"  via: {problem}")
        for st in summary["stitches"]:
            x, y = st["at"]
            print(
                f"  stitch: {st['net']} via at ({x:g}, {y:g}) ties the {st['layer']} island of "
                f"{', '.join(st['pads']) or 'vias only'} to {st['to']}"
            )
        for problem in summary["part_problems"]:
            print(f"  part: {problem}")
        for island in summary["islands"]:
            print(f"  island: {', '.join(island)} cut off from their pour; the DRC will report it")
        for f in summary["files"]:
            print(f"  wrote {f}")
        if code == EXIT_FAIL:
            print(
                f"design {design.name} red: {', '.join(red)}. The files are written for inspection only; "
                "a CI regenerate check fails on this exit code (1)."
            )
    return code


# --------------------------------------------------------------------- ci
#
# A repository's GitHub workflow replayed here, step by step as the runner runs it, so a push follows
# the checks its CI runs (PROCESSES.md P14, M85). PyYAML reads the workflow under the venv; the CLI runs it.

CI_SKIP = r"(?i)\b(install|upload)"
CI_EXPR_RE = re.compile(r"\$\{\{\s*(.*?)\s*\}\}")
CI_YAML_TO_JSON = (
    "import json, sys, yaml\n"
    "json.dump(yaml.safe_load(open(sys.argv[1], encoding='utf-8')), sys.stdout, default=str)\n"
)
# GitHub's shells on Linux: no `shell:` is `bash -e {0}`, `shell: bash` adds pipefail and no profile.
CI_SHELLS = {
    "": ["bash", "-e"],
    "bash": ["bash", "--noprofile", "--norc", "-eo", "pipefail"],
    "sh": ["sh", "-e"],
    "python": ["python3"],
}
CI_RUN = ("", "success()", "always()", "true", "!cancelled()")
CI_NOT_RUN = ("failure()", "cancelled()", "false")


def ci_condition(cond: object) -> bool | None:
    """An `if:` as the replay can judge it: True, False, or None when it names anything else."""
    if cond is None or cond is True:
        return True
    if cond is False:
        return False
    text = str(cond).strip()
    m = CI_EXPR_RE.fullmatch(text)
    text = m.group(1).strip() if m else text
    return True if text in CI_RUN else False if text in CI_NOT_RUN else None


def ci_expand(text: str, env: dict, context: dict) -> tuple[str, list[str]]:
    """`${{ ... }}` replaced as GitHub does before the shell runs: the env context and the github and runner
    values in `context`. Returns the text and the expressions the replay cannot read."""
    unknown: list[str] = []

    def sub(m: re.Match) -> str:
        expr = m.group(1)
        if re.fullmatch(r"env\.\w+", expr):
            return env.get(expr[4:], "")
        if expr in context:
            return context[expr]
        unknown.append(expr)
        return m.group(0)

    return CI_EXPR_RE.sub(sub, text), unknown


def ci_env_file(path: Path) -> dict[str, str]:
    """What a step wrote to $GITHUB_ENV: NAME=value lines and NAME<<DELIMITER blocks."""
    lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    out: dict[str, str] = {}
    i = 0
    while i < len(lines):
        m = re.fullmatch(r"([A-Za-z_]\w*)<<(.+)", lines[i])
        if m:
            end = next((k for k in range(i + 1, len(lines)) if lines[k] == m.group(2)), len(lines))
            out[m.group(1)] = "\n".join(lines[i + 1 : end])
            i = end + 1
            continue
        name, eq, value = lines[i].partition("=")
        if eq and re.fullmatch(r"[A-Za-z_]\w*", name):
            out[name] = value
        i += 1
    return out


def ci_job_order(jobs: dict) -> list[str]:
    """Job ids in the file's order, each after the jobs it needs."""
    order: list[str] = []

    def visit(job: str, path: tuple[str, ...] = ()) -> None:
        if job in order:
            return
        if job in path:
            raise ValueError(f"jobs that need each other: {' -> '.join((*path, job))}")
        needs = (jobs[job] or {}).get("needs") or []
        for n in [needs] if isinstance(needs, str) else needs:
            if n in jobs:
                visit(n, (*path, job))
        order.append(job)

    for job in jobs:
        visit(job)
    return order


def ci_step_name(step: dict) -> str:
    if step.get("name"):
        return str(step["name"])
    if step.get("uses"):
        return str(step["uses"])
    return "Run " + (str(step.get("run") or "").strip().splitlines() or [""])[0]


def cmd_ci(args) -> int:
    """Replay a repository's workflow `run` steps in order, as the runner would; CI REPLAY GREEN or RED."""
    repo = Path(args.repo).resolve()
    flow_dir = repo / ".github" / "workflows"
    if args.workflow:
        named = flow_dir / args.workflow
        flows = [named if named.is_file() else Path(args.workflow).resolve()]
        if not flows[0].is_file():
            raise SystemExit(f"ci: no workflow {args.workflow} in {flow_dir}")
    else:
        flows = sorted([*flow_dir.glob("*.yml"), *flow_dir.glob("*.yaml")]) if flow_dir.is_dir() else []
    say = (lambda *a, **k: None) if args.json else (lambda *a, **k: print(*a, **k, flush=True))
    if not flows:
        say(f"ci: no workflow in {flow_dir}")
        return EXIT_SKIP
    specs = []
    for flow in flows:
        proc = subprocess.run(
            [venv_python(), "-c", CI_YAML_TO_JSON, str(flow)],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if "No module named 'yaml'" in proc.stderr:
            print(f"ci: PyYAML is not in {venv_python()}; install.sh puts it there", file=sys.stderr)
            return EXIT_SKIP
        if proc.returncode != 0:
            print(f"ci: {flow}: {(proc.stderr.strip().splitlines() or ['unreadable'])[-1]}", file=sys.stderr)
            return EXIT_FAIL
        specs.append((flow, json.loads(proc.stdout) or {}))
    known = {job for _, spec in specs for job in (spec.get("jobs") or {})}
    unknown = sorted(set(args.job or []) - known)
    if unknown:
        raise SystemExit(f"ci: no job {', '.join(unknown)}; the jobs are {', '.join(sorted(known))}")
    out = Path(args.out).resolve() if args.out else repo / "build" / "ci"
    skip = re.compile(args.skip)
    records: list[dict] = []
    failed: list[str] = []
    for flow, spec in specs:
        jobs = spec.get("jobs") or {}
        flow_env = {str(k): str(v) for k, v in (spec.get("env") or {}).items()}
        flow_defaults = (spec.get("defaults") or {}).get("run") or {}
        for job_id in ci_job_order(jobs):
            if args.job and job_id not in args.job:
                continue
            job = jobs[job_id] or {}
            jdir = out / (f"{flow.stem}-{job_id}" if len(specs) > 1 else job_id)
            shutil.rmtree(jdir, ignore_errors=True)
            (jdir / "runner-temp").mkdir(parents=True)
            context = {
                "github.workspace": str(repo),
                "runner.temp": str(jdir / "runner-temp"),
                "runner.os": "Linux",
            }
            why = None
            if ci_condition(job.get("if")) is not True:
                why = (
                    f"if: {job.get('if')} not evaluated"
                    if ci_condition(job.get("if")) is None
                    else "if: false"
                )
            for key in ("strategy", "container", "services"):
                if job.get(key):
                    why = f"cannot replay a job with `{key}`"
            if why:
                records.append(
                    {"job": job_id, "step": None, "state": "skip" if "if:" in why else "red", "why": why}
                )
                say(f"[{job_id}] {'skip ' if 'if:' in why else 'RED  '} the job: {why}")
                if "if:" not in why:
                    failed.append(f"{job_id}: {why}")
                continue
            defaults = (job.get("defaults") or {}).get("run") or {}
            base = {**os.environ, **flow_env}
            for k, v in (job.get("env") or {}).items():
                base[str(k)], _ = ci_expand(str(v), base, context)
            added: dict[str, str] = {}
            paths: list[str] = []
            started = time.monotonic()
            job_limit = float(job.get("timeout-minutes") or 360) * 60
            for n, step in enumerate(job.get("steps") or [], 1):
                name = ci_step_name(step)
                rec = {"job": job_id, "step": name}
                cond = ci_condition(step.get("if"))
                if "run" not in step:
                    rec.update(state="skip", why=f"uses {step.get('uses')}")
                elif skip.search(name):
                    rec.update(state="skip", why=f"name matches {args.skip}")
                elif cond is not True:
                    rec.update(
                        state="skip", why=f"if: {step['if']}" + (" not evaluated" if cond is None else "")
                    )
                if rec.get("state"):
                    records.append(rec)
                    say(f"[{job_id}] skip  {name}  ({rec['why']})")
                    continue
                env = {**base, **added}
                bad: list[str] = []
                for k, v in (step.get("env") or {}).items():
                    env[str(k)], u = ci_expand(str(v), env, context)
                    bad += u
                script, u = ci_expand(str(step["run"]), env, context)
                bad += u
                shell = CI_SHELLS.get(
                    str(step.get("shell") or defaults.get("shell") or flow_defaults.get("shell") or "")
                )
                if bad or shell is None:
                    why = (
                        f"cannot replay ${{{{ {bad[0]} }}}}"
                        if bad
                        else f"cannot replay shell {step.get('shell')}"
                    )
                    rec.update(state="red", why=why)
                    records.append(rec)
                    failed.append(f"{job_id}: {name} ({why})")
                    say(f"[{job_id}] RED   {name}  ({why}; --skip its name to leave it out)")
                    break
                files = {
                    k: jdir / f"{n:02d}.{k.lower()}" for k in ("GITHUB_ENV", "GITHUB_PATH", "GITHUB_OUTPUT")
                }
                files["GITHUB_STEP_SUMMARY"] = jdir / f"{n:02d}.summary.md"
                for f in files.values():
                    f.write_text("", encoding="utf-8")
                env.update({k: str(f) for k, f in files.items()})
                env.update(
                    CI="true",
                    GITHUB_WORKSPACE=str(repo),
                    RUNNER_TEMP=context["runner.temp"],
                    RUNNER_OS="Linux",
                )
                if paths:
                    env["PATH"] = os.pathsep.join([*reversed(paths), env.get("PATH", "")])
                script_file = jdir / f"{n:02d}.{'py' if shell[0] == 'python3' else 'sh'}"
                script_file.write_text(script, encoding="utf-8")
                folder = (
                    step.get("working-directory")
                    or defaults.get("working-directory")
                    or flow_defaults.get("working-directory")
                    or ""
                )
                cwd = repo / str(folder)
                log = jdir / f"{n:02d}-{re.sub(r'[^A-Za-z0-9]+', '_', name).strip('_')[:60]}.log"
                limit = job_limit - (time.monotonic() - started)
                if step.get("timeout-minutes"):
                    limit = min(limit, float(step["timeout-minutes"]) * 60)
                say(f"[{job_id}] run   {name}  ({log})")
                t0 = time.monotonic()
                with log.open("w", encoding="utf-8") as fh:
                    try:
                        code = subprocess.run(
                            [*shell, str(script_file)],
                            cwd=cwd,
                            env=env,
                            stdout=fh,
                            stderr=subprocess.STDOUT,
                            timeout=max(limit, 1),
                        ).returncode
                    except subprocess.TimeoutExpired:
                        code = "timeout"
                added.update(ci_env_file(files["GITHUB_ENV"]))
                paths += [
                    ln.strip()
                    for ln in files["GITHUB_PATH"].read_text(encoding="utf-8").splitlines()
                    if ln.strip()
                ]
                seconds = round(time.monotonic() - t0, 1)
                rec.update(state="ok" if code == 0 else "red", exit=code, seconds=seconds, log=str(log))
                records.append(rec)
                say(f"[{job_id}] exit {code}  {name}  [{seconds}s]")
                if code != 0:
                    for ln in log.read_text(encoding="utf-8", errors="replace").splitlines()[-15:]:
                        say(f"       | {ln}")
                    if step.get("continue-on-error") is True:
                        rec["why"] = "continue-on-error"
                        continue
                    failed.append(f"{job_id}: {name}")
                    break
    ran = [r for r in records if r.get("state") in ("ok", "red")]
    verdict = EXIT_FAIL if failed else EXIT_PASS if ran else EXIT_SKIP
    line = (
        "CI REPLAY GREEN"
        if verdict == EXIT_PASS
        else "CI REPLAY RED: " + "; ".join(failed)
        if failed
        else ("CI REPLAY: no run step to replay")
    )
    if args.json:
        print(json.dumps({"repo": str(repo), "steps": records, "verdict": line}, indent=2))
    else:
        print(line)
    return verdict


# ----------------------------------------------------------------- mutate
#
# Proof that a firmware's host tests can fail (PROCESSES.md P18 step 4): each mutation breaks one behaviour
# in a copy of the tree, and the project's own test command must fail on it. The list stays in the project.

MUTATION_KEYS = ("name", "file", "old", "new")
MUTATE_TEST = "make -k test"
# A compiler's error line (gcc, clang): a mutant that does not build proves nothing about the tests.
BUILD_ERROR_RE = re.compile(r"^\S+?:\d+(?::\d+)?: (?:fatal )?error: .*$", re.M)


def read_mutations(path: Path) -> tuple[list[dict], str | None]:
    """The project's mutation list and its test command (None: the default). JSON: a list of {"name",
    "file", "old", "new"}, or {"test": CMD, "mutations": [...]}. Python: a top-level `MUTATIONS = [...]` of
    (name, file, old, new) tuples or dicts, and an optional `TEST = "..."`, read as literals and never run."""
    text = path.read_text(encoding="utf-8")
    test = None
    if path.suffix == ".py":
        found = {}
        for node in ast.parse(text, filename=str(path)).body:
            target = node.targets[0] if isinstance(node, ast.Assign) and len(node.targets) == 1 else None
            target = node.target if isinstance(node, ast.AnnAssign) else target
            if isinstance(target, ast.Name) and target.id in ("MUTATIONS", "TEST") and node.value is not None:
                try:
                    found[target.id] = ast.literal_eval(node.value)
                except ValueError as exc:
                    raise ValueError(
                        f"{path.name}:{node.lineno}: {target.id} is not a literal ({exc})"
                    ) from None
        if "MUTATIONS" not in found:
            raise ValueError(f"{path.name}: no top-level MUTATIONS = [...]")
        raw, test = found["MUTATIONS"], found.get("TEST")
    else:
        data = json.loads(text)
        raw, test = (data.get("mutations"), data.get("test")) if isinstance(data, dict) else (data, None)
    mutations: list[dict] = []
    for i, m in enumerate(raw or [], 1):
        if isinstance(m, (list, tuple)) and len(m) == len(MUTATION_KEYS):
            m = dict(zip(MUTATION_KEYS, m, strict=True))
        if not isinstance(m, dict) or any(not isinstance(m.get(k), str) for k in MUTATION_KEYS):
            raise ValueError(f"{path.name}: mutation {i} needs name, file, old and new, each as text")
        if not m["old"]:
            raise ValueError(f"{path.name}: mutation {i} ({m['name']}) has an empty old text")
        mutations.append({k: m[k] for k in MUTATION_KEYS})
    names = [m["name"] for m in mutations]
    twice = sorted({n for n in names if names.count(n) > 1})
    if twice:
        raise ValueError(f"{path.name}: mutation names used twice: {', '.join(twice)}")
    if test is not None and not isinstance(test, str):
        raise ValueError(f"{path.name}: TEST is not a command line")
    return mutations, test


def mutation_run(src: Path, work: Path, mutation: dict | None, test: str, timeout: int) -> dict:
    """Copy the tree (without build/), apply one mutation, run the test command there."""
    shutil.rmtree(work, ignore_errors=True)
    shutil.copytree(src, work, ignore=shutil.ignore_patterns("build"), symlinks=True)
    if mutation:
        path = work / mutation["file"]
        path.write_bytes(path.read_bytes().replace(mutation["old"].encode(), mutation["new"].encode(), 1))
    t0 = time.monotonic()
    try:
        proc = subprocess.run(["bash", "-c", test], cwd=work, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"exit": None, "line": f"the tests did not finish in {timeout} s", "seconds": timeout}
    text = (proc.stdout or "") + "\n" + (proc.stderr or "")
    lines = text.splitlines()
    error = BUILD_ERROR_RE.search(text)
    line = next((ln for ln in lines if "FAIL" in ln or "failed:" in ln), None)
    line = line or next((ln for ln in lines if "Error" in ln), "")
    return {
        "exit": proc.returncode,
        "build_error": error.group(0).strip() if error and proc.returncode != 0 else None,
        "line": line.strip(),
        "seconds": round(time.monotonic() - t0, 1),
        "tail": lines[-15:],
    }


def cmd_mutate(args) -> int:
    """Each mutation in the project's list, in its own copy of the firmware, must fail the tests."""
    src = Path(args.firmware).resolve()
    if not src.is_dir():
        raise SystemExit(f"mutate: {src} is not a folder")
    try:
        mutations, listed_test = read_mutations(Path(args.mutations).resolve())
    except (OSError, ValueError, SyntaxError) as exc:
        raise SystemExit(f"mutate: {exc}") from None
    test = args.test or listed_test or MUTATE_TEST
    if args.only:
        mutations = [m for m in mutations if any(o in m["name"] for o in args.only)]
    say = (lambda *a: None) if args.json else (lambda *a: print(*a, flush=True))
    # Every anchor is checked before anything runs: an old text that is not in its file exactly once
    # would mutate nothing, or the wrong place, and look like a survivor or a catch.
    anchors = []
    for m in mutations:
        path = src / m["file"]
        count = path.read_bytes().count(m["old"].encode()) if path.is_file() else -1
        if count != 1:
            anchors.append(
                f"{m['name']}: {m['file']} "
                + ("is not there" if count < 0 else f"holds the old text {count} times")
            )
    if anchors or not mutations:
        for a in anchors:
            print(f"mutate: anchor: {a}", file=sys.stderr)
        if not mutations:
            print("mutate: no mutation to run", file=sys.stderr)
        return EXIT_FAIL
    t0 = time.monotonic()
    work = Path(args.work).resolve() if args.work else Path(tempfile.mkdtemp(prefix="workcenter-mutate-"))
    try:
        base = mutation_run(src, work / "unmutated", None, test, args.timeout)
        if base["exit"] != 0:
            how = base["line"] if base["exit"] is None else f"exit {base['exit']}"
            print(f"mutate: `{test}` fails before any mutation ({how}):", file=sys.stderr)
            for ln in base.get("tail", []):
                print(f"       | {ln}", file=sys.stderr)
            return EXIT_FAIL
        say(f"mutate: {len(mutations)} mutations of {src}, `{test}` passes unmutated in {base['seconds']}s")

        def one(item: tuple[int, dict]) -> dict:
            copy = work / f"m{item[0]:03d}"
            result = mutation_run(src, copy, item[1], test, args.timeout)
            if not args.work:
                shutil.rmtree(copy, ignore_errors=True)
            return result

        results = []
        marks = {"caught": "caught  ", "survived": "SURVIVED", "no build": "NOBUILD "}
        with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
            for m, r in zip(mutations, pool.map(one, enumerate(mutations)), strict=True):
                state = "no build" if r.get("build_error") else "caught" if r["exit"] != 0 else "survived"
                results.append({"name": m["name"], "file": m["file"], "state": state, **r})
                say(f"{marks[state]} {m['name']}: {r.get('build_error') or r['line']}")
    finally:
        if not args.work:
            shutil.rmtree(work, ignore_errors=True)
    counts = {s: sum(r["state"] == s for r in results) for s in ("caught", "survived", "no build")}
    seconds = round(time.monotonic() - t0, 1)
    if args.json:
        for r in results:
            r.pop("tail", None)
        print(
            json.dumps({"firmware": str(src), "test": test, "counts": counts, "mutations": results}, indent=2)
        )
    else:
        print(
            f"mutate: {len(results)} mutations, {counts['caught']} caught, {counts['survived']} survived, "
            f"{counts['no build']} did not build  [{seconds}s]"
        )
        for r in results:
            if r["state"] != "caught":
                print(f"  {r['state']}: {r['name']} ({r['file']})")
    return EXIT_FAIL if counts["survived"] or counts["no build"] else EXIT_PASS


def check_design(args) -> int:
    """`design --check`: regenerate the design into a scratch folder (or --out) and compare the project and
    schematic files with the design's own, the way a board repository's CI does. Exit 1 on a difference
    or on the design step's own failure (M85), whose files CI would compare all the same."""
    if args.route:
        raise SystemExit("design: --check regenerates without routing, as CI does; leave out --route")
    design_path = Path(args.design).resolve()
    project_dir = design_path.parent
    keep = Path(args.out).resolve() if args.out else None
    if keep == project_dir:
        raise SystemExit("design: --check --out names the design's own folder; name a scratch folder")
    with contextlib.ExitStack() as stack:
        out_dir = keep or Path(stack.enter_context(tempfile.TemporaryDirectory(prefix="workcenter-check-")))
        run_args = argparse.Namespace(**{**vars(args), "out": str(out_dir), "route": False, "check": False})
        printed = io.StringIO()
        with contextlib.redirect_stdout(printed) if args.json else contextlib.nullcontext():
            code = cmd_design(run_args)
        regenerated = sorted(out_dir.glob("*.kicad_pro")) + sorted(out_dir.glob("*.kicad_sch"))
        files = []
        for f in regenerated:
            mine = project_dir / f.name
            entry = {"file": f.name, "state": "same"}
            if not mine.is_file():
                entry["state"] = "missing"
            elif mine.read_bytes() != f.read_bytes():
                old, new = mine.read_bytes().splitlines(), f.read_bytes().splitlines()
                pairs = enumerate(zip(old, new, strict=False))
                line = next((i for i, (a, b) in pairs if a != b), min(len(old), len(new)))
                entry.update(
                    state="differs",
                    line=line + 1,
                    project=old[line].decode(errors="replace").strip()[:100] if line < len(old) else "(end)",
                    design=new[line].decode(errors="replace").strip()[:100] if line < len(new) else "(end)",
                )
            files.append(entry)
    bad = [f for f in files if f["state"] != "same"]
    verdict = EXIT_FAIL if bad or code == EXIT_FAIL or not files else EXIT_PASS
    if args.json:
        summary = json.loads(printed.getvalue() or "{}")
        print(json.dumps({"design": summary, "design_exit": code, "files": files, "exit": verdict}, indent=2))
        return verdict
    for f in files:
        print(f"check: {f['state']:8} {f['file']}")
        if f["state"] == "differs":
            print(f"         line {f['line']}: project {f['project']!r}")
            print(f"         line {f['line']}: design  {f['design']!r}")
        elif f["state"] == "missing":
            print(f"         {project_dir} has no {f['file']}: generate it and commit it")
    if code == EXIT_FAIL:
        print(f"check: the design step exited {code}; a board repository's CI fails on it (M85)")
    if not files:
        print("check: the design wrote no .kicad_pro or .kicad_sch")
    name = design_path.parent.name
    if verdict == EXIT_PASS:
        print(f"check: {name}: {len(files)} files match {design_path.name}")
    else:
        print(f"check: {name}: red, {len(bad)} of {len(files)} files differ from {design_path.name}")
    return verdict


KISTACK_DIR = Path(os.environ.get("KISTACK_DIR", SRC_DIR / "third_party" / "kistack"))
# kistack's layout-placement checks that only read the board. move.py edits a board KiCad has open;
# a generated board changes in its design file instead.
PLACEMENT_CHECKS = ("pin_sides", "placement_audit", "route_check", "local_search", "group_search")
# Run one check with tools/kistack_board.py standing in for kistack's IPC reader.
PLACEMENT_RUNNER = """
import runpy, sys
sys.path.insert(0, sys.argv[1])
import kistack_board
sys.modules["ipc_board"] = kistack_board
script = sys.argv[2]
sys.argv = [script, *sys.argv[3:]]
runpy.run_path(script, run_name="__main__")
"""
# KiCad's Python module writes these to stderr on every load; they say nothing about the board.
KICAD_NOISE = re.compile(r"Debug: Adding duplicate image handler|property\.h\(\d+\): assert")


def venv_python() -> str:
    """The workcenter venv's Python (KiCad's pcbnew module, shapely), else this one."""
    py = WC_ROOT / "venv" / "bin" / "python"
    return str(py) if py.exists() else sys.executable


def cmd_placement(args) -> int:
    """Run one of kistack's layout-placement checks on a board file, headless."""
    name = args.check.removesuffix(".py")
    if name == "move":
        print(
            "placement: kistack's move.py edits a board that KiCad has open. A generated board changes in "
            "its design file: put the new position in design.py and run `workcenter design` again.",
            file=sys.stderr,
        )
        return EXIT_SKIP
    if name not in PLACEMENT_CHECKS:
        raise SystemExit(f"placement: {args.check!r} is not one of {', '.join(PLACEMENT_CHECKS)}")
    script = KISTACK_DIR / "skills" / "layout-placement" / "scripts" / f"{name}.py"
    if not script.is_file():
        print(f"placement: {script} is missing (KISTACK_DIR={KISTACK_DIR})", file=sys.stderr)
        return EXIT_SKIP
    project = find_project(args.board)
    if project.pcb is None:
        raise SystemExit(f"placement: {project.dir} has no .kicad_pcb")
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    proc = subprocess.run(
        [venv_python(), "-s", "-c", PLACEMENT_RUNNER, str(SRC_DIR / "tools"), str(script), str(project.pcb)]
        + list(args.args),
        capture_output=True,
        text=True,
        env=env,
    )
    sys.stdout.write(proc.stdout)
    sys.stderr.write("".join(ln for ln in proc.stderr.splitlines(True) if not KICAD_NOISE.search(ln)))
    if "No module named 'shapely'" in proc.stderr or "No module named 'pcbnew'" in proc.stderr:
        return EXIT_SKIP
    return EXIT_PASS if proc.returncode == 0 else EXIT_FAIL


